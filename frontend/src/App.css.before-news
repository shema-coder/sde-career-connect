@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap");

:root {
  --dark-blue: #071b3a;
  --deep-blue: #0b2854;
  --olive-yellow: #b6b52b;
  --olive-light: #d5d36b;
  --gold: #d7a928;
  --black: #050505;
  --white: #ffffff;
  --soft-white: #f7f8f4;
  --muted: #6d7480;
  --border: #e5e8df;
  --red: #c73838;
  --shadow: 0 20px 55px rgba(7, 27, 58, 0.1);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  font-family: "Inter", sans-serif;
  color: var(--dark-blue);
  background: var(--white);
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button,
a {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  text-decoration: none;
}

.container {
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
}

.site-shell {
  overflow: hidden;
  background: var(--white);
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(255, 255, 255, 0.95);
  border-bottom: 1px solid rgba(7, 27, 58, 0.08);
  backdrop-filter: blur(18px);
}

.nav-container {
  min-height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--dark-blue);
}

.brand-logo {
  width: 56px;
  height: 56px;
  object-fit: contain;
  border-radius: 50%;
  transition: transform 220ms ease;
}

.brand:hover .brand-logo {
  transform: rotate(-5deg) scale(1.05);
}

.brand-copy {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.brand-copy strong {
  font-size: 14px;
  letter-spacing: 0.8px;
}

.brand-copy span {
  color: var(--muted);
  font-size: 10px;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 25px;
}

.main-nav a {
  color: var(--dark-blue);
  font-size: 12px;
  font-weight: 700;
  transition: color 180ms ease;
}

.main-nav a:hover {
  color: var(--olive-yellow);
}

.nav-whatsapp {
  padding: 12px 17px;
  color: var(--black) !important;
  background: var(--olive-yellow);
  border-radius: 999px;
}

.menu-toggle {
  display: none;
  border: 0;
  color: var(--dark-blue);
  background: transparent;
  font-size: 25px;
}

.hero-section {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  color: var(--white);
  background:
    radial-gradient(circle at 90% 10%, rgba(215, 169, 40, 0.25), transparent 30%),
    linear-gradient(135deg, var(--dark-blue), var(--black));
}

.hero-decoration {
  position: absolute;
  z-index: -1;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.hero-decoration-one {
  width: 450px;
  height: 450px;
  right: -180px;
  top: -230px;
}

.hero-decoration-two {
  width: 300px;
  height: 300px;
  left: -180px;
  bottom: -200px;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 80px;
  min-height: 650px;
  padding-top: 80px;
  padding-bottom: 80px;
}

.hero-content {
  animation: rise-in 700ms ease both;
}

.eyebrow,
.section-kicker {
  display: inline-block;
  color: var(--olive-yellow);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 1.8px;
}

.hero-content h1 {
  max-width: 680px;
  margin: 22px 0;
  font-size: clamp(42px, 6vw, 76px);
  line-height: 1.03;
  letter-spacing: -3px;
}

.hero-content h1 span {
  display: block;
  color: var(--olive-yellow);
}

.hero-content p {
  max-width: 590px;
  color: rgba(255, 255, 255, 0.72);
  font-size: 15px;
  line-height: 1.9;
}

.hero-actions,
.support-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 30px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  min-height: 48px;
  padding: 13px 20px;
  border: 1px solid transparent;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 900;
  transition:
    transform 180ms ease,
    background 180ms ease,
    box-shadow 180ms ease;
}

.button:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 25px rgba(0, 0, 0, 0.16);
}

.button-yellow {
  color: var(--black);
  background: var(--olive-yellow);
}

.button-yellow:hover {
  color: var(--black);
  background: var(--gold);
}

.button-outline-light {
  color: var(--white);
  border-color: rgba(255, 255, 255, 0.35);
  background: transparent;
}

.button-outline-light:hover {
  color: var(--white);
  background: rgba(255, 255, 255, 0.1);
}

.button-dark {
  color: var(--white);
  background: var(--dark-blue);
}

.hero-trust {
  display: flex;
  flex-wrap: wrap;
  gap: 35px;
  margin-top: 55px;
}

.hero-trust div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.hero-trust strong {
  color: var(--white);
  font-size: 28px;
}

.hero-trust span {
  color: rgba(255, 255, 255, 0.55);
  font-size: 10px;
}

.hero-card {
  position: relative;
  padding: 36px;
  color: var(--dark-blue);
  background: var(--white);
  border-radius: 28px;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.25);
  animation: float-card 5s ease-in-out infinite;
}

.hero-card-top {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 1px;
}

.live-dot {
  color: var(--red);
}

.hero-card-icon {
  display: grid;
  width: 90px;
  height: 90px;
  margin: 45px 0 25px;
  place-items: center;
  font-size: 43px;
  background: var(--soft-white);
  border-radius: 24px;
}

.hero-card h2 {
  margin: 0 0 18px;
  font-size: 32px;
  line-height: 1.12;
  letter-spacing: -1px;
}

.hero-card p {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.8;
}

.hero-card-link {
  display: inline-block;
  margin-top: 20px;
  color: var(--dark-blue);
  font-size: 12px;
  font-weight: 900;
}

.opportunities-section {
  padding: 105px 0;
  background: var(--white);
}

.section-heading-row {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 35px;
}

.section-heading-row h2,
.about-card h2 {
  margin: 12px 0;
  font-size: clamp(30px, 4vw, 48px);
  line-height: 1.08;
  letter-spacing: -1.5px;
}

.section-heading-row p {
  max-width: 600px;
  margin: 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.8;
}

.text-link {
  color: var(--dark-blue);
  font-size: 12px;
  font-weight: 900;
  white-space: nowrap;
}

.category-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-bottom: 30px;
}

.category-tabs button {
  padding: 11px 18px;
  color: var(--dark-blue);
  background: var(--soft-white);
  border: 1px solid var(--border);
  border-radius: 999px;
  font-size: 11px;
  font-weight: 800;
  transition: all 180ms ease;
}

.category-tabs button:hover,
.category-tabs button.active {
  color: var(--black);
  background: var(--olive-yellow);
  border-color: var(--olive-yellow);
}

.opportunity-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}

.opportunity-card {
  overflow: hidden;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 22px;
  box-shadow: 0 8px 30px rgba(7, 27, 58, 0.04);
  transition:
    transform 220ms ease,
    box-shadow 220ms ease,
    border-color 220ms ease;
  animation: rise-in 600ms ease both;
}

.opportunity-card:hover {
  transform: translateY(-8px);
  border-color: var(--olive-yellow);
  box-shadow: var(--shadow);
}

.featured-card {
  border: 2px solid var(--olive-yellow);
}

.post-visual {
  position: relative;
  display: grid;
  min-height: 220px;
  place-items: center;
  overflow: hidden;
  color: var(--white);
  background: linear-gradient(135deg, var(--dark-blue), var(--deep-blue));
}

.post-pattern {
  position: absolute;
  inset: -50px;
  background:
    linear-gradient(120deg, transparent 45%, rgba(182, 181, 43, 0.2) 46%, transparent 48%),
    linear-gradient(30deg, transparent 45%, rgba(215, 169, 40, 0.2) 46%, transparent 48%);
  background-size: 70px 70px;
  transform: rotate(8deg);
}

.post-icon {
  position: relative;
  z-index: 1;
  display: grid;
  width: 100px;
  height: 100px;
  place-items: center;
  font-size: 50px;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.25);
  border-radius: 30px;
  backdrop-filter: blur(10px);
}

.urgent-badge,
.post-number {
  position: absolute;
  z-index: 2;
  top: 18px;
  padding: 8px 11px;
  border-radius: 999px;
  font-size: 9px;
  font-weight: 900;
}

.urgent-badge {
  left: 18px;
  color: var(--black);
  background: var(--olive-yellow);
}

.post-number {
  right: 18px;
  color: var(--white);
  background: rgba(0, 0, 0, 0.25);
}

.post-body {
  padding: 25px;
}

.post-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 15px;
}

.post-meta span {
  color: var(--olive-yellow);
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
}

.post-meta small {
  color: var(--muted);
  font-size: 9px;
}

.post-body h3 {
  min-height: 65px;
  margin: 0 0 14px;
  color: var(--dark-blue);
  font-size: 20px;
  line-height: 1.3;
  letter-spacing: -0.5px;
}

.post-body p {
  min-height: 85px;
  margin: 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.8;
}

.post-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 25px;
  padding-top: 20px;
  border-top: 1px solid var(--border);
}

.read-more,
.post-whatsapp {
  border: 0;
  font-size: 11px;
  font-weight: 900;
}

.read-more {
  padding: 0;
  color: var(--dark-blue);
  background: transparent;
}

.post-whatsapp {
  padding: 10px 12px;
  color: var(--black);
  background: var(--olive-yellow);
  border-radius: 999px;
}

.support-section {
  padding: 105px 0;
  background: var(--soft-white);
}

.support-grid {
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  align-items: center;
  gap: 80px;
}

.support-image-wrap {
  position: relative;
  max-width: 430px;
  justify-self: center;
}

.support-image-glow {
  position: absolute;
  inset: 35px -25px -25px 25px;
  background: var(--olive-yellow);
  border-radius: 28px;
  transform: rotate(-6deg);
}

.support-image {
  position: relative;
  display: block;
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  object-position: center top;
  border: 9px solid var(--white);
  border-radius: 28px;
  box-shadow: 0 25px 60px rgba(7, 27, 58, 0.18);
}

.support-image-label {
  position: absolute;
  right: -25px;
  bottom: 25px;
  display: flex;
  flex-direction: column;
  gap: 5px;
  max-width: 245px;
  padding: 18px 20px;
  color: var(--white);
  background: var(--dark-blue);
  border-left: 5px solid var(--gold);
  border-radius: 12px;
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.18);
}

.support-image-label strong {
  font-size: 13px;
}

.support-image-label span {
  color: var(--olive-light);
  font-size: 10px;
  line-height: 1.5;
}

.support-content h2 {
  max-width: 650px;
  margin: 15px 0 20px;
  color: var(--dark-blue);
  font-size: clamp(30px, 4vw, 48px);
  line-height: 1.1;
  letter-spacing: -1.7px;
}

.support-content > p {
  max-width: 620px;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.9;
}

.support-checklist {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin: 28px 0;
}

.support-checklist div {
  padding: 13px 14px;
  color: var(--dark-blue);
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 9px;
  font-size: 12px;
  font-weight: 700;
}

.support-phone {
  display: inline-block;
  margin-top: 25px;
  color: var(--dark-blue);
  font-size: 16px;
  font-weight: 900;
}

.about-section {
  padding: 80px 0;
  background: var(--white);
}

.about-card {
  display: grid;
  grid-template-columns: 1fr 1fr auto;
  align-items: center;
  gap: 35px;
  padding: 45px;
  color: var(--white);
  background: var(--dark-blue);
  border-radius: 25px;
}

.about-card h2 {
  margin-bottom: 0;
  color: var(--white);
}

.about-card p {
  color: rgba(255, 255, 255, 0.7);
  font-size: 13px;
  line-height: 1.9;
}

.site-footer {
  padding: 45px 0 25px;
  color: var(--white);
  background: var(--black);
}

.footer-content,
.footer-brand,
.footer-links,
.footer-bottom {
  display: flex;
  align-items: center;
}

.footer-content {
  justify-content: space-between;
  gap: 30px;
}

.footer-brand {
  gap: 12px;
}

.footer-brand img {
  width: 52px;
  height: 52px;
  object-fit: contain;
}

.footer-brand div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.footer-brand strong {
  font-size: 12px;
}

.footer-brand span,
.footer-bottom {
  color: rgba(255, 255, 255, 0.55);
  font-size: 10px;
}

.footer-links {
  flex-wrap: wrap;
  justify-content: end;
  gap: 20px;
}

.footer-links a {
  color: var(--olive-light);
  font-size: 11px;
  font-weight: 800;
}

.footer-bottom {
  justify-content: space-between;
  gap: 20px;
  margin-top: 35px;
  padding-top: 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(8px);
}

.post-modal {
  position: relative;
  width: min(560px, 100%);
  padding: 40px;
  color: var(--dark-blue);
  background: var(--white);
  border-top: 6px solid var(--olive-yellow);
  border-radius: 22px;
  box-shadow: 0 30px 100px rgba(0, 0, 0, 0.35);
  animation: rise-in 250ms ease both;
}

.post-modal h2 {
  margin: 15px 0;
  font-size: 30px;
  line-height: 1.15;
}

.post-modal p {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.9;
}

.modal-close {
  position: absolute;
  top: 15px;
  right: 15px;
  width: 35px;
  height: 35px;
  border: 0;
  color: var(--dark-blue);
  background: var(--soft-white);
  border-radius: 50%;
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(24px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes float-card {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-10px);
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

@media (max-width: 1050px) {
  .hero-grid {
    grid-template-columns: 1fr 0.8fr;
    gap: 40px;
  }

  .main-nav {
    gap: 15px;
  }

  .about-card {
    grid-template-columns: 1fr 1fr;
  }

  .about-card .button {
    justify-self: start;
  }
}

@media (max-width: 820px) {
  .menu-toggle {
    display: block;
  }

  .main-nav {
    position: absolute;
    top: 82px;
    right: 20px;
    left: 20px;
    display: none;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 15px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: var(--shadow);
  }

  .main-nav.is-open {
    display: flex;
  }

  .main-nav a {
    padding: 14px;
  }

  .hero-grid,
  .support-grid {
    grid-template-columns: 1fr;
  }

  .hero-grid {
    padding-top: 65px;
    padding-bottom: 65px;
  }

  .hero-card {
    max-width: 550px;
  }

  .opportunity-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .section-heading-row {
    align-items: start;
    flex-direction: column;
  }

  .support-image-wrap {
    width: min(100%, 430px);
  }

  .about-card {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 560px) {
  .container {
    width: min(100% - 28px, 1180px);
  }

  .brand-logo {
    width: 45px;
    height: 45px;
  }

  .brand-copy strong {
    font-size: 11px;
  }

  .brand-copy span {
    font-size: 8px;
  }

  .hero-content h1 {
    font-size: 43px;
    letter-spacing: -1.8px;
  }

  .hero-actions .button,
  .support-actions .button {
    width: 100%;
  }

  .hero-trust {
    gap: 20px;
  }

  .hero-trust strong {
    font-size: 23px;
  }

  .hero-card {
    padding: 25px;
  }

  .opportunities-section,
  .support-section {
    padding: 70px 0;
  }

  .opportunity-grid {
    grid-template-columns: 1fr;
  }

  .post-body h3,
  .post-body p {
    min-height: auto;
  }

  .support-checklist {
    grid-template-columns: 1fr;
  }

  .support-image-label {
    right: 8px;
    bottom: 18px;
  }

  .about-card {
    padding: 28px;
  }

  .footer-content,
  .footer-bottom {
    align-items: start;
    flex-direction: column;
  }

  .footer-links {
    justify-content: start;
  }

  .post-modal {
    padding: 30px 24px;
  }
}

/* =========================================================
   SMART HERO VIDEO CARD
   ========================================================= */

.hero-video-card {
  position: relative;
  min-width: 0;
  padding: 18px;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 28px;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.13), rgba(255, 255, 255, 0.04)),
    rgba(3, 13, 31, 0.92);
  box-shadow: 0 28px 70px rgba(0, 0, 0, 0.28);
  overflow: hidden;
  animation: float-card 7s ease-in-out infinite;
}

.video-heading {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 9px;
  margin-bottom: 14px;
  color: var(--white);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.video-live-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--olive-yellow);
  box-shadow: 0 0 0 5px rgba(182, 181, 43, 0.13);
  animation: video-pulse 2s ease-in-out infinite;
}

.video-badge {
  margin-left: auto;
  padding: 5px 9px;
  border: 1px solid rgba(213, 211, 107, 0.4);
  border-radius: 999px;
  color: var(--olive-light);
  font-size: 0.62rem;
  letter-spacing: 0.04em;
}

.video-frame {
  position: relative;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  border-radius: 19px;
  background: #020914;
  isolation: isolate;
}

.hero-video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  background: #020914;
}

.video-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 24px;
  color: var(--white);
  text-align: center;
  background: linear-gradient(
    180deg,
    rgba(7, 27, 58, 0.08),
    rgba(7, 27, 58, 0.65)
  );
  pointer-events: none;
}

.video-overlay-logo {
  width: 78px;
  height: 78px;
  object-fit: contain;
  filter: drop-shadow(0 8px 22px rgba(0, 0, 0, 0.3));
  animation: logo-pulse 4s ease-in-out infinite;
}

.video-overlay span {
  font-size: clamp(0.85rem, 1.8vw, 1.1rem);
  font-weight: 800;
  letter-spacing: 0.04em;
}

.video-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding-top: 17px;
}

.video-card-footer > div {
  display: grid;
  gap: 5px;
  min-width: 0;
}

.video-card-footer strong {
  color: var(--white);
  font-size: 0.95rem;
}

.video-card-footer span {
  color: rgba(255, 255, 255, 0.66);
  font-size: 0.78rem;
  line-height: 1.5;
}

.video-contact-link {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 11px 14px;
  border-radius: 999px;
  background: var(--olive-yellow);
  color: var(--black);
  font-size: 0.78rem;
  font-weight: 900;
  text-decoration: none;
  transition:
    transform 180ms ease,
    background 180ms ease;
}

.video-contact-link:hover {
  transform: translateY(-2px);
  background: var(--olive-light);
}

@keyframes video-pulse {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }

  50% {
    opacity: 0.45;
    transform: scale(0.78);
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-video-card,
  .video-live-dot,
  .video-overlay-logo {
    animation: none;
  }
}

@media (max-width: 640px) {
  .hero-video-card {
    padding: 12px;
    border-radius: 21px;
  }

  .video-heading {
    font-size: 0.68rem;
  }

  .video-badge {
    margin-left: 0;
  }

  .video-card-footer {
    align-items: stretch;
    flex-direction: column;
  }

  .video-contact-link {
    justify-content: center;
    width: 100%;
  }
}

