/* =========================================================
   FORM FIELDS
   ========================================================= */

.application-form,
.form-grid {
  display: grid;
  gap: 18px;
}

.form-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.form-field {
  min-width: 0;
}

.form-field.full,
.form-field.span-2 {
  grid-column: 1 / -1;
}

.form-field label {
  display: block;
  margin-bottom: 8px;
  color: #344054;
  font-size: 13px;
  font-weight: 750;
}

.form-field input,
.form-field select,
.form-field textarea {
  width: 100%;
  min-height: 50px;
  box-sizing: border-box;
  border: 1px solid #d8dee8;
  border-radius: 13px;
  background: #fff;
  color: #172033;
  padding: 12px 14px;
  outline: none;
  font: inherit;
  transition:
    border-color .2s ease,
    box-shadow .2s ease,
    background .2s ease;
}

.form-field textarea {
  min-height: 110px;
  resize: vertical;
}

.form-field input:hover,
.form-field select:hover,
.form-field textarea:hover {
  border-color: #b9c4d5;
}

.form-field input:focus,
.form-field select:focus,
.form-field textarea:focus {
  border-color: var(--sde-blue);
  box-shadow: 0 0 0 4px rgba(20,87,217,.09);
}

.field-error {
  margin-top: 7px;
  color: #c62835;
  font-size: 12px;
}

/* ---------- Radio / gender / yes-no ---------- */

.choice-grid,
.gender-options,
.radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.choice-option,
.gender-option,
.radio-option {
  position: relative;
  flex: 1 1 140px;
  min-height: 48px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 14px;
  border: 1px solid #dce2eb;
  border-radius: 13px;
  background: #fff;
  cursor: pointer;
  transition: all .2s ease;
}

.choice-option:hover,
.gender-option:hover,
.radio-option:hover {
  border-color: rgba(20,87,217,.35);
  background: #f8faff;
}

.choice-option.selected,
.gender-option.selected,
.radio-option.selected {
  border-color: var(--sde-blue);
  background: var(--sde-blue-soft);
}

/* =========================================================
   UPLOAD CARDS
   ========================================================= */

.upload-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.upload-card {
  position: relative;
  min-height: 210px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 20px;
  text-align: center;
  border: 1.5px dashed #cbd4e2;
  border-radius: 20px;
  background: #fbfcfe;
  transition: all .25s ease;
}

.upload-card:hover {
  border-color: var(--sde-blue);
  background: var(--sde-blue-soft);
  transform: translateY(-2px);
}

.upload-card.has-file {
  border-style: solid;
  border-color: rgba(22,163,106,.45);
  background: var(--sde-green-soft);
}

.upload-icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  margin-bottom: 13px;
  border-radius: 14px;
  background: #eef2f8;
  color: var(--sde-blue);
  font-size: 21px;
}

.upload-card strong {
  font-size: 14px;
}

.upload-card p {
  max-width: 230px;
  margin: 6px 0 14px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.5;
}

/* =========================================================
   FACULTY / PROGRAM CHOICES
   ========================================================= */

.faculty-choice-list {
  display: grid;
  gap: 12px;
  counter-reset: preference;
}

.faculty-choice {
  display: grid;
  grid-template-columns: 48px 1fr;
  align-items: center;
  gap: 14px;
  padding: 15px;
  border: 1px solid var(--line);
  border-radius: 17px;
  background: #fff;
  transition: all .22s ease;
}

.faculty-choice:hover {
  border-color: rgba(20,87,217,.3);
  box-shadow: var(--shadow-sm);
}

.faculty-number {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: var(--sde-blue-soft);
  color: var(--sde-blue);
  font-weight: 900;
}

/* =========================================================
   REVIEW
   ========================================================= */

.review-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 16px;
}

.review-card {
  padding: 20px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: #fff;
  box-shadow: var(--shadow-sm);
}

.review-card h3 {
  margin: 0 0 14px;
  font-size: 15px;
}

.review-row {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 9px 0;
  border-bottom: 1px solid #eef1f5;
}

.review-row:last-child {
  border-bottom: 0;
}

.review-row span:first-child {
  color: var(--muted);
  font-size: 12px;
}

.review-row span:last-child {
  color: #273246;
  font-size: 13px;
  font-weight: 650;
  text-align: right;
}

/* =========================================================
   ACTIONS
   ========================================================= */

.application-actions {
  position: sticky;
  bottom: 0;
  z-index: 20;
  display: flex;
  justify-content: space-between;
  gap: 14px;
  margin-top: 32px;
  padding: 17px 0;
  background: linear-gradient(
    to bottom,
    rgba(246,248,252,0),
    rgba(246,248,252,.96) 28%
  );
  backdrop-filter: blur(7px);
}

.application-actions button,
.submit-action {
  min-height: 50px;
  border-radius: 13px;
  padding: 0 22px;
  font-weight: 800;
  cursor: pointer;
  transition: all .2s ease;
}

.submit-action {
  border: 0;
  background: linear-gradient(135deg, #1457d9, #2f73ef);
  color: #fff;
  box-shadow: 0 12px 28px rgba(20,87,217,.24);
}

.submit-action:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 17px 34px rgba(20,87,217,.3);
}

.submit-action:disabled {
  opacity: .65;
  cursor: wait;
}

.consent-box {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  margin-top: 20px;
  padding: 15px;
  border: 1px solid #e2e7ef;
  border-radius: 15px;
  background: #f9fafc;
  color: #475467;
  font-size: 13px;
  line-height: 1.55;
}

.consent-box input {
  width: 18px;
  height: 18px;
  margin-top: 1px;
  accent-color: var(--sde-blue);
}

/* =========================================================
   ERROR BANNER
   ========================================================= */

.submit-error-banner {
  margin-top: 15px;
  padding: 13px 15px;
  border: 1px solid #f0c5ca;
  border-radius: 13px;
  background: #fff2f3;
  color: #a61b28;
  font-size: 13px;
}

/* =========================================================
   PREMIUM SUCCESS SCREEN
   ========================================================= */

.application-success {
  position: relative;
  min-height: 100vh;
  display: grid;
  place-items: center;
  overflow: hidden;
  padding: 50px 20px;
  background:
    radial-gradient(circle at 50% 10%, rgba(20,87,217,.13), transparent 30%),
    radial-gradient(circle at 20% 80%, rgba(22,163,106,.10), transparent 28%),
    #f7f9fd;
}

.application-success::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
    radial-gradient(circle, rgba(20,87,217,.10) 1px, transparent 1px);
  background-size: 30px 30px;
  mask-image: linear-gradient(to bottom, black, transparent 80%);
}

.success-content {
  position: relative;
  z-index: 4;
  width: min(780px, 100%);
  text-align: center;
}

.sde-logo-placeholder {
  width: 72px;
  height: 72px;
  display: grid;
  place-items: center;
  margin: 0 auto 20px;
  border-radius: 22px;
  background: #111827;
  color: #fff;
  font-weight: 950;
  font-size: 20px;
  letter-spacing: -.04em;
  box-shadow: 0 16px 38px rgba(17,24,39,.2);
}

.success-medal {
  position: relative;
  width: 128px;
  height: 128px;
  display: grid;
  place-items: center;
  margin: 0 auto 20px;
  border-radius: 50%;
  background: linear-gradient(145deg, #fff, #eef4ff);
  border: 1px solid #dbe5f5;
  box-shadow:
    0 25px 65px rgba(20,87,217,.15),
    inset 0 0 0 10px rgba(255,255,255,.7);
  animation: trophyFloat 3s ease-in-out infinite;
}

@keyframes trophyFloat {
  0%,100% { transform: translateY(0) rotate(-1deg); }
  50% { transform: translateY(-7px) rotate(1deg); }
}

.success-trophy {
  font-size: 58px;
  line-height: 1;
  filter: drop-shadow(0 8px 10px rgba(245,197,66,.25));
}

.success-checkmark {
  position: absolute;
  right: -4px;
  bottom: 7px;
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border: 4px solid #f7f9fd;
  border-radius: 50%;
  background: var(--sde-green);
  color: #fff;
  font-weight: 900;
}

.application-success h1 {
  margin: 0;
  color: #101828;
  font-size: clamp(34px, 6vw, 58px);
  line-height: 1;
  letter-spacing: -.055em;
}

.application-success .success-subtitle {
  max-width: 620px;
  margin: 18px auto 0;
  color: var(--muted);
  font-size: 16px;
  line-height: 1.7;
}

.request-card {
  margin: 30px auto 18px;
  padding: 20px;
  border: 1px solid #dfe6f1;
  border-radius: 20px;
  background: rgba(255,255,255,.94);
  box-shadow: var(--shadow-md);
}

.request-card .request-label {
  color: #98a2b3;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .13em;
  text-transform: uppercase;
}

.request-card .request-id {
  display: block;
  margin-top: 8px;
  color: #111827;
  font-size: clamp(20px, 4vw, 28px);
  font-weight: 900;
  letter-spacing: .02em;
}

.success-status {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 13px;
  border-radius: 999px;
  background: var(--sde-green-soft);
  color: #087443;
  font-size: 12px;
  font-weight: 800;
}

.success-next {
  margin-top: 26px;
  padding: 22px;
  border-radius: 22px;
  background: #fff;
  border: 1px solid var(--line);
  text-align: left;
  box-shadow: var(--shadow-sm);
}

.success-next h2 {
  margin: 0 0 15px;
  font-size: 17px;
}

.success-next-item {
  display: grid;
  grid-template-columns: 36px 1fr;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid #edf0f4;
}

.success-next-item:last-child {
  border-bottom: 0;
}

.success-next-item .number {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: var(--sde-blue-soft);
  color: var(--sde-blue);
  font-size: 11px;
  font-weight: 900;
}

.success-next-item strong {
  display: block;
  margin-bottom: 3px;
  font-size: 13px;
}

.success-next-item p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.5;
}

.success-actions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 22px;
}

/* ---------- Confetti ---------- */

.celebration-confetti {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  overflow: hidden;
}

.confetti-piece {
  position: absolute;
  top: -30px;
  width: 8px;
  height: 15px;
  border-radius: 2px;
  opacity: .9;
  animation: confettiFall linear infinite;
}

.confetti-piece:nth-child(3n) {
  width: 6px;
  height: 12px;
}

.confetti-piece:nth-child(4n) {
  border-radius: 50%;
}

@keyframes confettiFall {
  0% {
    transform: translate3d(0,-30px,0) rotate(0deg);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  100% {
    transform: translate3d(70px,110vh,0) rotate(720deg);
    opacity: 0;
  }
}

.celebration-glow {
  position: absolute;
  width: 360px;
  height: 360px;
  border-radius: 50%;
  background: rgba(20,87,217,.09);
  filter: blur(45px);
  pointer-events: none;
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 900px) {
  .institution-grid,
  .upload-grid {
    grid-template-columns: 1fr;
  }

  .institution-card {
    min-height: 190px;
  }

  .institution-guidance-grid {
    grid-template-columns: 1fr;
  }

  .review-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 700px) {
  .application-content {
    width: min(100% - 24px, 620px);
    padding-top: 28px;
    padding-bottom: 70px;
  }

  .intro-block h1 {
    font-size: 32px;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .form-field.full,
  .form-field.span-2 {
    grid-column: auto;
  }

  .institution-guidance-card {
    padding: 18px;
    border-radius: 20px;
  }

  .institution-guidance-header {
    flex-direction: column-reverse;
  }

  .institution-guidance-badge {
    width: 54px;
    min-width: 54px;
    height: 54px;
  }

  .application-actions {
    margin-left: -12px;
    margin-right: -12px;
    padding: 13px 12px;
  }

  .application-actions button,
  .submit-action {
    flex: 1;
    padding: 0 14px;
  }

  .application-success {
    padding: 35px 16px;
  }

  .success-medal {
    width: 108px;
    height: 108px;
  }

  .success-trophy {
    font-size: 48px;
  }

  .application-success h1 {
    font-size: 39px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
  }
}



/* =========================================================
   SDE PREMIUM CONFIRMATION — CARD SYSTEM
   ========================================================= */

.application-success {
  isolation: isolate;
}

.celebration-glow-one {
  top: 5%;
  left: 10%;
}

.celebration-glow-two {
  right: 5%;
  bottom: 5%;
  background: rgba(22,163,106,.07);
}

.success-content {
  max-width: 850px;
}

.success-status {
  margin-bottom: 18px;
}

.application-success h1 {
  margin-top: 4px;
}

.success-reference-card,
.success-info-card,
.success-important-card,
.success-section-card,
.success-institution-card,
.success-support-card {
  width: 100%;
  box-sizing: border-box;
}

/* ---------- Shared card labels ---------- */

.success-card-eyebrow {
  display: block;
  margin-bottom: 7px;
  color: #7a8495;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .14em;
  text-transform: uppercase;
}

/* ---------- Reference ---------- */

.success-reference-card {
  margin-top: 30px;
  padding: 23px;
  border: 1px solid #dce4f0;
  border-radius: 22px;
  background:
    linear-gradient(145deg, #ffffff, #f9fbff);
  box-shadow:
    0 20px 50px rgba(24,39,75,.09);
  text-align: left;
}

.success-reference-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}

.success-reference-id {
  display: block;
  color: #101828;
  font-size: clamp(21px, 4vw, 30px);
  line-height: 1.2;
  letter-spacing: .015em;
  word-break: break-word;
}

.success-reference-card p {
  margin: 13px 0 0;
  color: #667085;
  font-size: 12px;
  line-height: 1.6;
}

.copy-reference-button {
  flex: 0 0 auto;
  min-height: 42px;
  padding: 0 14px;
  border: 1px solid #d8e0eb;
  border-radius: 12px;
  background: #fff;
  color: #344054;
  font: inherit;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  transition: all .2s ease;
}

.copy-reference-button:hover {
  border-color: #1457d9;
  color: #1457d9;
  background: #f4f7ff;
}

/* ---------- Received card ---------- */

.success-info-card {
  display: flex;
  align-items: flex-start;
  gap: 15px;
  margin-top: 15px;
  padding: 20px;
  border: 1px solid #dcefe5;
  border-radius: 19px;
  background: #f8fdf9;
  text-align: left;
}

.success-info-icon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  flex: 0 0 42px;
  border-radius: 13px;
  font-weight: 900;
  font-size: 17px;
}

.success-icon-green {
  background: #ddf7e9;
  color: #087443;
}

.success-info-card strong {
  display: block;
  margin: 2px 0 6px;
  color: #172033;
  font-size: 14px;
}

.success-info-card p {
  margin: 0;
  color: #667085;
  font-size: 13px;
  line-height: 1.6;
}

/* ---------- Important notice ---------- */

.success-important-card {
  display: flex;
  align-items: flex-start;
  gap: 15px;
  margin-top: 15px;
  padding: 22px;
  border: 1px solid #f1dfad;
  border-radius: 21px;
  background:
    linear-gradient(145deg, #fffdf6, #fff9e9);
  text-align: left;
  box-shadow: 0 12px 35px rgba(133,96,0,.06);
}

.success-icon-warning {
  background: #ffedbd;
