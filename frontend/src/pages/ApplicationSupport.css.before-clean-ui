/* =========================================================
   SDE CAREER CONNECT — PREMIUM APPLICATION EXPERIENCE
   ========================================================= */

.application-support {
  --sde-blue: #1457d9;
  --sde-blue-dark: #0d3fa8;
  --sde-blue-soft: #eef4ff;
  --sde-green: #16a36a;
  --sde-green-soft: #ecfbf4;
  --sde-yellow: #f5c542;
  --sde-red: #d63b45;
  --ink: #172033;
  --muted: #687386;
  --line: #e5e9f0;
  --surface: #ffffff;
  --surface-soft: #f7f9fc;
  --shadow-sm: 0 8px 24px rgba(24, 39, 75, 0.06);
  --shadow-md: 0 18px 55px rgba(24, 39, 75, 0.10);
  --radius-lg: 24px;
  --radius-md: 16px;
}

/* ---------- Main shell ---------- */

.application-support {
  min-height: 100vh;
  background:
    radial-gradient(circle at 10% 0%, rgba(20, 87, 217, 0.08), transparent 28%),
    radial-gradient(circle at 90% 10%, rgba(22, 163, 106, 0.06), transparent 24%),
    #f6f8fc;
  color: var(--ink);
}

.application-shell {
  min-height: 100vh;
}

.application-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(255,255,255,.92);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid rgba(229,233,240,.85);
}

/* ---------- Progress ---------- */

.application-progress,
.progress-bar,
.step-progress {
  position: relative;
}

.progress-track {
  height: 5px;
  background: #e9edf4;
  border-radius: 999px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--sde-blue), #4f86ff);
  border-radius: inherit;
  transition: width .45s cubic-bezier(.2,.8,.2,1);
}

.step-indicator,
.steps-indicator {
  gap: 10px;
}

.step-item {
  transition: all .25s ease;
}

.step-item.active {
  color: var(--sde-blue);
  font-weight: 700;
}

.step-item.completed {
  color: var(--sde-green);
}

/* ---------- Content ---------- */

.application-content {
  width: min(1120px, calc(100% - 40px));
  margin: 0 auto;
  padding: 42px 0 90px;
}

.form-step {
  animation: sdeStepIn .42s cubic-bezier(.2,.8,.2,1);
}

@keyframes sdeStepIn {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.intro-block {
  max-width: 760px;
  margin-bottom: 30px;
}

.intro-block h1 {
  margin: 8px 0 10px;
  font-size: clamp(28px, 4vw, 44px);
  line-height: 1.05;
  letter-spacing: -.035em;
  color: #111827;
}

.intro-block p {
  max-width: 680px;
  color: var(--muted);
  font-size: 16px;
  line-height: 1.7;
}

.section-tag {
  display: inline-flex;
  align-items: center;
  padding: 7px 11px;
  border-radius: 999px;
  background: var(--sde-blue-soft);
  color: var(--sde-blue);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .11em;
}

/* =========================================================
   INSTITUTION CARDS
   ========================================================= */

.institution-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-top: 28px;
}

.institution-card {
  position: relative;
  min-height: 230px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 24px;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: rgba(255,255,255,.94);
  box-shadow: var(--shadow-sm);
  cursor: pointer;
  text-align: left;
  transition:
    transform .28s ease,
    box-shadow .28s ease,
    border-color .28s ease,
    background .28s ease;
}

.institution-card:hover {
  transform: translateY(-5px);
  border-color: rgba(20,87,217,.28);
  box-shadow: var(--shadow-md);
}

.institution-card.selected {
  border-color: var(--sde-blue);
  background:
    linear-gradient(145deg, rgba(238,244,255,.98), #fff);
  box-shadow:
    0 0 0 4px rgba(20,87,217,.08),
    0 22px 55px rgba(20,87,217,.12);
}

.institution-logo {
  width: 64px;
  height: 64px;
  display: grid;
  place-items: center;
  overflow: hidden;
  border-radius: 18px;
  background: #f3f6fb;
  border: 1px solid #e5eaf2;
  margin-bottom: 20px;
}

.institution-logo img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 9px;
}

.logo-fallback {
  display: grid;
  place-items: center;
  width: 100%;
  height: 100%;
  color: var(--sde-blue);
  font-weight: 900;
  font-size: 18px;
}

.logo-fallback:not(.visible) {
  display: grid;
}

.institution-copy {
  padding-right: 30px;
}

.institution-code {
  display: inline-block;
  margin-bottom: 6px;
  color: var(--sde-blue);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .12em;
}

.institution-copy h3 {
  margin: 0 0 8px;
  font-size: 19px;
  line-height: 1.25;
}

.institution-copy p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.55;
}

.selection-check {
  position: absolute;
  right: 20px;
  bottom: 20px;
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #f1f4f8;
  color: #667085;
  font-weight: 800;
}

.institution-card.selected .selection-check {
  background: var(--sde-blue);
  color: #fff;
}

