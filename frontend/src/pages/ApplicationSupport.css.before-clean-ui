}

.success-section-heading {
  margin-bottom: 20px;
}

.success-section-heading h2 {
  margin: 0 0 5px;
  color: #101828;
  font-size: 21px;
}

.success-section-heading p {
  margin: 0;
  color: #7a8495;
  font-size: 13px;
  line-height: 1.55;
}

.success-steps-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
