.success-step-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 30px rgba(24,39,75,.08);
}

.success-step-number {
  color: #a0a9b8;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .1em;
}

.success-step-icon {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  margin: 15px 0 14px;
  border-radius: 12px;
  background: #edf3ff;
  color: #1457d9;
