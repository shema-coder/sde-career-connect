.success-institution-icon {
  width: 62px;
  height: 62px;
  display: grid;
  place-items: center;
  flex: 0 0 62px;
  border-radius: 17px;
  background: #eaf1ff;
  color: #1457d9;
  font-size: 13px;
  font-weight: 950;
}

.success-institution-copy h2 {
  margin: 0 0 5px;
  color: #172033;
  font-size: 17px;
}

.success-institution-copy p {
  margin: 0;
  color: #667085;
  font-size: 12px;
  line-height: 1.55;
