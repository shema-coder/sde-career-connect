/* =========================================================
   SDE APPLICATION SUPPORT — RELIABLE PAGE SCROLL
   ========================================================= */

/*
 * The support experience is a fixed overlay, but the overlay itself
 * must remain vertically scrollable when its content is taller than
 * the viewport.
 */
.application-shell {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100dvh;
  min-height: 100dvh;
  overflow-x: hidden;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-y: contain;
}

/*
 * Keep the actual application content naturally expandable.
 */
.application-shell > * {
  max-width: 100%;
}

/*
 * Confirmation screen must also scroll independently.
 */
.application-success {
  width: 100%;
  min-height: 100%;
  height: auto;
  overflow: visible;
}

/*
 * Decorative confetti/glows should never create horizontal scrolling.
 */
.celebration-confetti,
.celebration-glow {
  pointer-events: none;
}

/*
 * Prevent mobile browsers from trapping the page inside a fixed-height
 * content area.
 */
@media (max-width: 768px) {
  .application-shell {
    height: 100dvh;
    min-height: 100dvh;
    overflow-x: hidden;
    overflow-y: auto;
  }

  .application-success {
    min-height: 100%;
    padding-bottom: 100px;
  }
}

/*
 * Accessibility: remove motion when requested.
 */
@media (prefers-reduced-motion: reduce) {
  .application-shell {
    scroll-behavior: auto;
  }
}


/* =========================================================
   FINAL APPLICATION SHELL LAYOUT
   One scroll container — no fixed footer overlay
   ========================================================= */

.application-shell {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100dvh;
  min-height: 0;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  overflow-x: hidden;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-y: contain;
}

.application-shell > * {
  box-sizing: border-box;
  max-width: 100%;
}

.application-panel {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 100%;
  height: auto;
  margin: 0;
  box-sizing: border-box;
  overflow: visible;
}

.application-content {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
  overflow: visible;
}

/*
 * The old footer was fixed to the viewport and covered the
 * bottom portion of Step 1. It now belongs to normal document flow.
 */
.application-footer {
  position: relative;
  inset: auto;
  bottom: auto;
  left: auto;
  right: auto;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  z-index: 1;
}

/*
 * Prevent the old footer from creating a second visual divider
 * across the application when it is not needed.
 */
.application-footer::before,
.application-footer::after {
  box-sizing: border-box;
}

/*
 * Step 1 action must remain inside the document flow.
 */
.smart-next-card {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.smart-next-button {
  position: relative;
  z-index: 2;
  visibility: visible;
  pointer-events: auto;
}

/*
 * No horizontal page overflow from any application child.
 */
.application-shell,
.application-panel,
.application-content,
.form-step {
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

/*
 * Mobile: the application itself scrolls naturally.
 */
@media (max-width: 768px) {
  .application-shell {
    width: 100%;
    height: 100dvh;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
  }

  .application-panel {
    min-height: 100%;
    height: auto;
  }

  .application-content {
    overflow: visible;
  }

  .application-footer {
    position: relative;
    bottom: auto;
  }
}


/* =========================================================
   SDE CAREER CONNECT
   STEP 1 VISUAL RESTORATION
   Do not alter application shell / steps 2–5
   ========================================================= */

