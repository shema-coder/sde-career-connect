/* ---------- Celebration ---------- */

.celebration-glow {
  position: absolute;
  width: 420px;
  height: 420px;
  border-radius: 50%;
  filter: blur(80px);
  opacity: .24;
  pointer-events: none;
}

.celebration-glow-one {
  top: -170px;
  left: 10%;
  background: #60a5fa;
}

.celebration-glow-two {
  right: 5%;
  bottom: -200px;
  background: #86efac;
}

.celebration-confetti {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 3;
}

.confetti-piece {
  --size: 7px;
  position: absolute;
  top: -20px;
  left: calc(50% + var(--x));
  width: var(--size);
  height: calc(var(--size) * 1.8);
  border-radius: 2px;
  background: hsl(calc((var(--i) * 47) % 360), 78%, 58%);
  transform: rotate(var(--r));
  animation:
    confettiFall 5s cubic-bezier(.2,.65,.3,1) var(--d) infinite;
  opacity: .85;
}

.confetti-piece:nth-child(3n) {
  width: 5px;
  height: 12px;
  border-radius: 50%;
}

.confetti-piece:nth-child(4n) {
  width: 10px;
  height: 5px;
}

@keyframes confettiFall {
  0% {
    transform: translate3d(0, -30px, 0) rotate(var(--r));
    opacity: 0;
  }
  10% {
    opacity: .9;
  }
  100% {
    transform: translate3d(calc(var(--x) * .35), 105vh, 0)
      rotate(calc(var(--r) + 720deg));
    opacity: 0;
  }
}

