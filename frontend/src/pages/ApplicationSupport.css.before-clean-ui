/* =========================================================
   SDE CAREER CONNECT — FINAL APPLICATION SUPPORT UI
   Premium UX override layer
   ========================================================= */

.application-support {
  --sde-blue: #2563eb;
  --sde-blue-dark: #1d4ed8;
  --sde-green: #16a34a;
  --sde-yellow: #f4c430;
  --sde-ink: #0f172a;
  --sde-muted: #64748b;
  --sde-border: #e2e8f0;
  --sde-soft: #f8fafc;
  --sde-white: #ffffff;
  background:
    radial-gradient(circle at 10% 0%, rgba(37, 99, 235, .09), transparent 30%),
    radial-gradient(circle at 90% 10%, rgba(22, 163, 74, .07), transparent 26%),
    #f7f9fc;
}

/* ---------- Main shell ---------- */

.application-shell {
  width: min(1180px, calc(100% - 32px));
  margin: 24px auto;
  border: 1px solid rgba(226, 232, 240, .9);
  border-radius: 28px;
  background: rgba(255, 255, 255, .94);
  box-shadow:
    0 24px 70px rgba(15, 23, 42, .10),
    0 4px 18px rgba(15, 23, 42, .05);
  overflow: hidden;
  backdrop-filter: blur(16px);
}

.application-content {
  padding: 36px;
}

.form-step {
  animation: sdeStepIn .35s ease both;
}

@keyframes sdeStepIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ---------- Intro ---------- */

.intro-block {
  margin-bottom: 28px;
}

.intro-block h1,
.intro-block h2 {
  color: var(--sde-ink);
  letter-spacing: -.035em;
}

.intro-block p {
  color: var(--sde-muted);
  line-height: 1.7;
  max-width: 760px;
}

/* ---------- Form sections ---------- */

.form-section {
  position: relative;
  margin-bottom: 22px;
  padding: 24px;
  border: 1px solid var(--sde-border);
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 8px 28px rgba(15, 23, 42, .045);
}

.form-section-heading {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  margin-bottom: 20px;
}

.form-section-heading h3,
.form-section-heading h4 {
  margin: 0;
  color: var(--sde-ink);
  font-size: 1.05rem;
  letter-spacing: -.02em;
}

.form-section-heading p {
  margin: 5px 0 0;
  color: var(--sde-muted);
  font-size: .88rem;
  line-height: 1.55;
}

/* ---------- Fields ---------- */

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.field {
  min-width: 0;
}

.field label {
  display: block;
  margin-bottom: 8px;
  color: #334155;
  font-size: .83rem;
  font-weight: 750;
  letter-spacing: .01em;
}

.field input,
.field select,
.field textarea {
  width: 100%;
  min-height: 48px;
  border: 1px solid #dbe3ee;
  border-radius: 12px;
  background: #fff;
  color: var(--sde-ink);
  padding: 12px 14px;
  outline: none;
  transition:
    border-color .2s ease,
    box-shadow .2s ease,
    transform .2s ease,
    background .2s ease;
}

.field input:hover,
.field select:hover,
.field textarea:hover {
  border-color: #b8c7da;
}

.field input:focus,
.field select:focus,
.field textarea:focus {
  border-color: var(--sde-blue);
  box-shadow: 0 0 0 4px rgba(37, 99, 235, .10);
  background: #fff;
}

.field small,
.field-error {
  display: block;
  margin-top: 6px;
  font-size: .76rem;
  line-height: 1.45;
}

.field-error {
  color: #dc2626;
}

/* ---------- Gender / Yes-No cards ---------- */

.gender-options,
.choice-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.gender-options button,
.choice-row button {
  min-height: 58px;
  border: 1px solid var(--sde-border);
  border-radius: 15px;
  background: #fff;
  color: #334155;
  font-weight: 700;
  cursor: pointer;
  transition: all .2s ease;
}

.gender-options button:hover,
.choice-row button:hover {
  border-color: #93b4ef;
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(37, 99, 235, .08);
}

.gender-options button.active,
.choice-row button.active,
.gender-options button[aria-pressed="true"],
.choice-row button[aria-pressed="true"] {
  border-color: var(--sde-blue);
  background: linear-gradient(135deg, #eff6ff, #fff);
  color: var(--sde-blue-dark);
  box-shadow: 0 8px 22px rgba(37, 99, 235, .12);
}

/* ---------- Institution guidance ---------- */

.institution-guidance-card {
  margin-top: 24px;
  padding: 26px;
  border: 1px solid #dce7f7;
  border-radius: 22px;
  background:
    linear-gradient(145deg, #f8fbff 0%, #fff 62%);
  box-shadow: 0 14px 34px rgba(37, 99, 235, .07);
}

.institution-guidance-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
}

.institution-guidance-header h2 {
  margin: 4px 0 6px;
  color: var(--sde-ink);
  letter-spacing: -.03em;
}

.institution-guidance-header p {
  max-width: 700px;
  margin: 0;
  color: var(--sde-muted);
  line-height: 1.65;
}

.institution-guidance-eyebrow {
  color: var(--sde-blue-dark);
  font-size: .72rem;
  font-weight: 850;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.institution-guidance-badge {
  flex: 0 0 auto;
  min-width: 58px;
  height: 58px;
  display: grid;
  place-items: center;
  border-radius: 17px;
  background: var(--sde-ink);
  color: #fff;
  font-weight: 900;
  box-shadow: 0 10px 25px rgba(15, 23, 42, .16);
}

.institution-guidance-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.guidance-column {
  padding: 20px;
  border: 1px solid #e7edf5;
  border-radius: 18px;
  background: #fff;
}

.guidance-column-heading {
  display: flex;
  gap: 11px;
  align-items: center;
  margin-bottom: 14px;
}

.guidance-icon {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: #eff6ff;
  color: var(--sde-blue);
  font-weight: 900;
}

.guidance-column-heading strong {
  display: block;
  color: var(--sde-ink);
  font-size: .9rem;
}

.guidance-column-heading small {
  display: block;
  margin-top: 2px;
  color: var(--sde-muted);
}

.guidance-column ul,
.guidance-important ul,
.guidance-scholarship ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

.guidance-column li {
  display: flex;
  gap: 9px;
  padding: 8px 0;
  color: #475569;
  font-size: .86rem;
  line-height: 1.5;
}

.guidance-column li > span:first-child {
  flex: 0 0 auto;
  color: var(--sde-green);
  font-weight: 900;
}

.guidance-important,
.guidance-scholarship,
.guidance-support-note {
  display: flex;
  gap: 13px;
  margin-top: 16px;
  padding: 16px 18px;
  border-radius: 16px;
}

.guidance-important {
  background: #fffaf0;
  border: 1px solid #f5dfae;
}

.guidance-scholarship {
  background: #f5fdf7;
  border: 1px solid #ccebd5;
}

.guidance-support-note {
  background: #f8fafc;
  border: 1px solid #e5eaf1;
}

.guidance-important-icon,
.guidance-scholarship-icon {
  flex: 0 0 auto;
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  font-weight: 900;
}

.guidance-important-icon {
  background: #fff0c7;
  color: #a16207;
}

.guidance-scholarship-icon {
  background: #dcfce7;
  color: #15803d;
}

.guidance-important strong,
.guidance-scholarship strong {
  color: var(--sde-ink);
}

.guidance-important li,
.guidance-scholarship li {
  margin-top: 5px;
  color: #475569;
  font-size: .84rem;
  line-height: 1.5;
}

.guidance-support-note p {
  margin: 0;
  color: #475569;
  font-size: .84rem;
  line-height: 1.55;
}

/* ---------- Documents ---------- */

.upload-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.upload-card {
  min-height: 210px;
  padding: 20px;
  border: 1px dashed #cbd5e1;
  border-radius: 18px;
  background: linear-gradient(180deg, #fff, #f8fafc);
  transition: all .2s ease;
}

.upload-card:hover {
  border-color: var(--sde-blue);
  background: #fbfdff;
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(37, 99, 235, .08);
}

.upload-card.has-file,
.upload-card.selected {
  border-style: solid;
  border-color: #86b3f4;
  background: #f8fbff;
}

.upload-card input[type="file"] {
  width: 100%;
  margin-top: 12px;
}

.upload-card strong {
  display: block;
  color: var(--sde-ink);
}

.upload-card p {
  color: var(--sde-muted);
  font-size: .82rem;
  line-height: 1.5;
}

/* ---------- Faculty / programme choices ---------- */

.faculty-list,
.faculty-choice-list {
  display: grid;
  gap: 12px;
}

.choice-field {
  position: relative;
}

.faculty-list .choice-field,
.faculty-choice-list .choice-field {
  padding: 16px;
  border: 1px solid var(--sde-border);
  border-radius: 16px;
  background: #fff;
  transition: all .2s ease;
}

.faculty-list .choice-field:hover,
.faculty-choice-list .choice-field:hover {
  border-color: #a8c2e9;
  box-shadow: 0 8px 22px rgba(15, 23, 42, .055);
}

.faculty-list .choice-field::before,
.faculty-choice-list .choice-field::before {
  content: attr(data-choice);
}

/* ---------- Review ---------- */

.review-institution {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 18px;
  margin-bottom: 18px;
  border: 1px solid #dbe7f8;
  border-radius: 18px;
  background: #f8fbff;
}

.review-section {
  margin-top: 16px;
  padding: 20px;
  border: 1px solid var(--sde-border);
  border-radius: 18px;
  background: #fff;
}

.review-section h3 {
  margin-top: 0;
  color: var(--sde-ink);
}

.review-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.review-row {
  padding: 12px 14px;
  border-radius: 12px;
  background: #f8fafc;
}

.review-row strong,
.review-row span {
  display: block;
}

.review-row strong {
  color: #64748b;
  font-size: .73rem;
  text-transform: uppercase;
  letter-spacing: .06em;
}

.review-row span {
  margin-top: 4px;
  color: var(--sde-ink);
  font-weight: 650;
  word-break: break-word;
}

.review-file {
  padding: 12px 14px;
  border: 1px solid #e5eaf1;
  border-radius: 13px;
  background: #fafcff;
}

/* ---------- SDE disclaimer ---------- */

.sde-portal-disclaimer {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  margin: 20px 0;
  padding: 18px;
  border: 1px solid #bfdbfe;
  border-radius: 17px;
  background: linear-gradient(135deg, #eff6ff, #f8fbff);
}

.sde-portal-disclaimer-icon {
  flex: 0 0 auto;
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: var(--sde-blue);
  color: #fff;
  font-weight: 900;
}

.sde-portal-disclaimer strong {
  color: #172554;
}

.sde-portal-disclaimer p {
  margin: 5px 0 0;
  color: #475569;
  font-size: .84rem;
  line-height: 1.6;
}

/* ---------- Consent ---------- */

.consent-box {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 17px;
  border: 1px solid var(--sde-border);
  border-radius: 16px;
  background: #f8fafc;
  cursor: pointer;
}

.consent-box input {
  width: 19px;
  height: 19px;
  margin-top: 2px;
  accent-color: var(--sde-blue);
}

.consent-box span {
  color: #475569;
  font-size: .84rem;
  line-height: 1.55;
}

/* ---------- Bottom actions ---------- */

.application-actions {
  position: sticky;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin: 28px -36px -36px;
  padding: 18px 36px;
  border-top: 1px solid rgba(226, 232, 240, .9);
  background: rgba(255, 255, 255, .94);
  backdrop-filter: blur(14px);
}

.primary-action,
.secondary-action {
  min-height: 48px;
  border-radius: 13px;
  padding: 0 20px;
  font-weight: 800;
  cursor: pointer;
  transition: all .2s ease;
}

.primary-action {
  border: 1px solid var(--sde-blue);
  background: linear-gradient(135deg, var(--sde-blue), var(--sde-blue-dark));
  color: #fff;
  box-shadow: 0 8px 22px rgba(37, 99, 235, .22);
}

.primary-action:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(37, 99, 235, .28);
}

.primary-action:disabled {
  opacity: .65;
  cursor: not-allowed;
}

.secondary-action {
  border: 1px solid var(--sde-border);
  background: #fff;
  color: #334155;
}

.secondary-action:hover {
  border-color: #aebed1;
  background: #f8fafc;
}

/* =========================================================
   PREMIUM CONFIRMATION SCREEN
   ========================================================= */

.application-success {
  position: relative;
  min-height: 100%;
  padding: 34px;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 0%, rgba(37, 99, 235, .12), transparent 35%),
    #f8fafc;
}

.success-content {
  position: relative;
  z-index: 2;
  width: min(920px, 100%);
  margin: 0 auto;
  text-align: center;
}

.success-medal {
  position: relative;
  width: 116px;
  height: 116px;
  margin: 4px auto 20px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: linear-gradient(145deg, #fff, #fef9e7);
  border: 8px solid #fff;
  box-shadow:
    0 18px 45px rgba(15, 23, 42, .14),
    0 0 0 1px #f0df9d;
}

.success-trophy {
  font-size: 3.3rem;
  filter: drop-shadow(0 7px 12px rgba(15, 23, 42, .14));
}

.success-content h1 {
  margin: 0;
  color: var(--sde-ink);
  font-size: clamp(2rem, 5vw, 3.5rem);
  line-height: 1.05;
  letter-spacing: -.055em;
}

.success-content > p {
  max-width: 650px;
  margin: 14px auto 26px;
  color: var(--sde-muted);
  line-height: 1.7;
}

.success-reference-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin: 24px 0;
  padding: 20px 22px;
  border: 1px solid #dbe7f8;
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 12px 32px rgba(15, 23, 42, .06);
  text-align: left;
}

.success-reference-top {
  color: #64748b;
  font-size: .72rem;
  font-weight: 850;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.success-reference-id {
  margin-top: 5px;
  color: var(--sde-ink);
  font-size: 1.1rem;
  font-weight: 900;
  letter-spacing: .03em;
}

.success-status {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 12px;
  border-radius: 999px;
  background: #ecfdf3;
  color: #15803d;
  font-size: .78rem;
  font-weight: 850;
}

.success-info-card,
.success-important-card,
.success-institution-card,
.success-support-card {
  margin-top: 16px;
  padding: 22px;
  border: 1px solid var(--sde-border);
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 8px 26px rgba(15, 23, 42, .045);
  text-align: left;
}

.success-section-heading {
  display: flex;
  align-items: center;
  gap: 11px;
  margin-bottom: 15px;
}

.success-section-heading strong {
  color: var(--sde-ink);
}

.success-steps-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.success-step-card {
  padding: 18px;
  border: 1px solid #e6ebf2;
  border-radius: 16px;
  background: #fafcff;
}

.success-step-number {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: #eff6ff;
  color: var(--sde-blue);
  font-weight: 900;
}

.success-step-card strong {
  display: block;
  margin-top: 13px;
  color: var(--sde-ink);
}

.success-step-card p {
  margin: 5px 0 0;
  color: var(--sde-muted);
  font-size: .82rem;
  line-height: 1.55;
}

.success-important-card {
  border-color: #f1dfae;
  background: #fffdf6;
}

.success-important-note {
  color: #6b4f0a;
  font-size: .86rem;
  line-height: 1.65;
}

.success-institution-card {
  display: flex;
  align-items: center;
  gap: 15px;
}

.success-institution-icon {
  width: 52px;
  height: 52px;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  border-radius: 15px;
  background: var(--sde-ink);
  color: #fff;
  font-weight: 900;
}

.success-institution-copy strong {
  display: block;
  color: var(--sde-ink);
}

.success-institution-copy span {
  display: block;
  margin-top: 3px;
  color: var(--sde-muted);
  font-size: .82rem;
}

.success-actions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 24px;
}

.success-support-button,
.success-back-button {
  min-height: 48px;
  padding: 0 20px;
  border-radius: 13px;
  font-weight: 800;
  text-decoration: none;
  transition: all .2s ease;
}

.success-support-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #16a34a;
  color: #fff;
  box-shadow: 0 8px 22px rgba(22, 163, 74, .2);
}

.success-support-button:hover {
  transform: translateY(-2px);
}

.success-back-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--sde-border);
  background: #fff;
  color: #334155;
}

/* ---------- Celebration ---------- */

.celebration-confetti {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 1;
}

.confetti-piece {
  position: absolute;
  top: -30px;
  width: 8px;
  height: 16px;
  border-radius: 2px;
  background: var(--confetti-color, #2563eb);
  animation: sdeConfetti 4.2s linear infinite;
  opacity: .9;
}

.confetti-piece:nth-child(3n) {
  --confetti-color: #16a34a;
}

.confetti-piece:nth-child(4n) {
  --confetti-color: #f4c430;
}

.confetti-piece:nth-child(5n) {
  --confetti-color: #dc2626;
}

@keyframes sdeConfetti {
  0% {
    transform: translate3d(0, -20px, 0) rotate(0deg);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  100% {
    transform: translate3d(70px, 105vh, 0) rotate(720deg);
    opacity: .85;
  }
}

.celebration-glow {
  position: absolute;
  width: 420px;
  height: 420px;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
  border-radius: 50%;
  background: rgba(37, 99, 235, .08);
  filter: blur(55px);
  pointer-events: none;
}

/* ---------- Mobile ---------- */

@media (max-width: 900px) {
  .application-content {
    padding: 24px;
  }

  .application-actions {
    margin-left: -24px;
    margin-right: -24px;
    margin-bottom: -24px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .institution-guidance-grid,
  .upload-grid {
    grid-template-columns: 1fr;
  }

  .success-steps-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 680px) {
  .application-shell {
    width: 100%;
    margin: 0;
    border-radius: 0;
    border-left: 0;
    border-right: 0;
  }

  .application-content {
    padding: 18px;
  }

  .form-grid,
  .review-grid {
    grid-template-columns: 1fr;
  }

  .gender-options,
  .choice-row {
    grid-template-columns: 1fr;
  }

  .form-section,
  .institution-guidance-card,
  .success-info-card,
  .success-important-card,
  .success-institution-card,
  .success-support-card {
    padding: 18px;
    border-radius: 17px;
  }

  .institution-guidance-header {
    flex-direction: column;
  }

  .institution-guidance-badge {
    min-width: 48px;
    width: 48px;
    height: 48px;
  }

  .application-actions {
    position: sticky;
    flex-direction: column-reverse;
    align-items: stretch;
    margin-left: -18px;
    margin-right: -18px;
    margin-bottom: -18px;
    padding: 14px 18px;
  }

  .application-actions button {
    width: 100%;
  }

  .success-reference-card {
    align-items: flex-start;
    flex-direction: column;
  }

  .success-content h1 {
    font-size: 2.35rem;
  }

  .success-actions {
    flex-direction: column;
  }

  .success-support-button,
  .success-back-button {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .form-step,
  .confetti-piece,
  .primary-action,
  .secondary-action,
  .upload-card,
  .gender-options button,
  .choice-row button {
    animation: none !important;
    transition: none !important;
  }
}


/* =========================================================
   SDE — FINAL PREMIUM CONFIRMATION EXPERIENCE
   ========================================================= */

.application-success {
  position: relative;
  min-height: min(900px, 100vh);
  overflow: hidden;
  padding: 56px 24px 70px;
  display: flex;
  justify-content: center;
  background:
    radial-gradient(circle at 50% -10%, rgba(37, 99, 235, .18), transparent 34%),
    radial-gradient(circle at 0% 45%, rgba(22, 163, 74, .09), transparent 28%),
    radial-gradient(circle at 100% 65%, rgba(244, 196, 48, .10), transparent 25%),
    #f8fafc;
}

.success-content {
  position: relative;
  z-index: 5;
  width: min(900px, 100%);
  text-align: center;
}

.success-close {
  position: absolute;
  z-index: 20;
  top: 20px;
  right: 20px;
  width: 44px;
  height: 44px;
  border: 1px solid rgba(15, 23, 42, .08);
  border-radius: 50%;
  background: rgba(255,255,255,.86);
