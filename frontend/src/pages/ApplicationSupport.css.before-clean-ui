}

.success-important-card h2 {
  margin: 0 0 9px;
  color: #4f3a00;
  font-size: 17px;
  line-height: 1.4;
}

.success-important-card p {
  margin: 0;
  color: #6c5a2c;
  font-size: 13px;
  line-height: 1.65;
}

.success-important-note {
  margin-top: 12px !important;
  padding: 11px 13px;
  border-radius: 11px;
  background: rgba(255,255,255,.65);
  color: #5b4508 !important;
}

/* ---------- Journey section ---------- */

.success-section-card {
  margin-top: 18px;
  padding: 25px;
  border: 1px solid #e1e6ee;
  border-radius: 23px;
  background: #fff;
  text-align: left;
