}

.success-step-card h3 {
  margin: 0 0 7px;
  color: #1d2939;
  font-size: 14px;
}

.success-step-card p {
  margin: 0;
  color: #667085;
  font-size: 12px;
  line-height: 1.55;
}

/* ---------- Selected institution ---------- */

.success-institution-card {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-top: 18px;
  padding: 20px;
  border: 1px solid #dce6fa;
  border-radius: 21px;
  background:
    linear-gradient(145deg, #f7faff, #fff);
