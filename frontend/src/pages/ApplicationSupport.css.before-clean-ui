.application-shell {
  position: fixed;
  inset: 0;
  z-index: 9999;
  overflow-y: auto;
  background: #f4f7fb;
  color: #172033;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
    "Segoe UI", sans-serif;
}

.application-panel {
  min-height: 100vh;
  background: #f7f9fc;
}

.application-header {
  height: 76px;
  padding: 0 5vw;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-bottom: 1px solid #e8edf4;
  position: sticky;
  top: 0;
  z-index: 20;
}

.application-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: #111827;
  color: #ffffff;
  font-size: 13px;
  font-weight: 900;
  letter-spacing: -0.5px;
}

.application-brand strong {
  display: block;
  color: #111827;
  font-size: 15px;
  font-weight: 800;
}

.application-brand span {
  display: block;
  margin-top: 2px;
  color: #718096;
  font-size: 12px;
}

.application-close {
  width: 42px;
  height: 42px;
  border: 1px solid #e1e7ef;
  border-radius: 50%;
  background: #ffffff;
  color: #344054;
  font-size: 25px;
  line-height: 1;
  cursor: pointer;
  transition: 0.2s ease;
}

.application-close:hover {
  background: #f1f4f8;
  transform: rotate(4deg);
}

.application-progress {
  max-width: 1180px;
  margin: 0 auto;
  padding: 34px 28px 22px;
}

.progress-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20px;
}

.progress-eyebrow,
.section-tag {
  display: inline-block;
  color: #2563eb;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 1.4px;
}

.progress-top h2 {
  margin: 5px 0 2px;
  color: #101828;
  font-size: 27px;
  letter-spacing: -0.8px;
}

.progress-top p {
  margin: 0;
  color: #667085;
  font-size: 13px;
}

.progress-top > strong {
  color: #2563eb;
  font-size: 20px;
}

.progress-track {
  height: 6px;
  margin-top: 20px;
  overflow: hidden;
  border-radius: 20px;
  background: #e7edf5;
}

.progress-track > div {
  height: 100%;
  border-radius: inherit;
  background: #2563eb;
  transition: width 0.3s ease;
}

.step-indicators {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12px;
  margin-top: 20px;
}

.step-indicator {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #98a2b3;
  min-width: 0;
}

.step-indicator span {
  width: 25px;
  height: 25px;
  flex: 0 0 25px;
  display: grid;
  place-items: center;
  border: 1px solid #dce3ec;
  border-radius: 50%;
  font-size: 11px;
  font-weight: 800;
  background: #ffffff;
}

.step-indicator small {
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
}

.step-indicator.active {
  color: #2563eb;
}

.step-indicator.active span {
  border-color: #2563eb;
  background: #2563eb;
  color: #ffffff;
}

.step-indicator.complete {
  color: #344054;
}

.step-indicator.complete span {
  border-color: #d0d5dd;
  background: #e9eef5;
  color: #344054;
}

.application-content {
  max-width: 1180px;
  margin: 0 auto;
  padding: 10px 28px 125px;
}

.form-step {
  animation: applicationFade 0.25s ease;
}

@keyframes applicationFade {
  from {
    opacity: 0;
    transform: translateY(6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.intro-block {
  max-width: 760px;
  margin-bottom: 30px;
}

.intro-block h1 {
  margin: 7px 0 8px;
  color: #101828;
  font-size: clamp(30px, 4vw, 44px);
  line-height: 1.08;
  letter-spacing: -1.7px;
}

.intro-block p {
  margin: 0;
  max-width: 680px;
  color: #667085;
  font-size: 15px;
  line-height: 1.7;
}

/* Institutions */

.institution-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.institution-card {
  position: relative;
  min-height: 225px;
  padding: 24px;
  text-align: left;
  border: 1px solid #e1e7ef;
  border-radius: 20px;
  background: #ffffff;
  cursor: pointer;
  transition: 0.22s ease;
  box-shadow: 0 5px 20px rgba(16, 24, 40, 0.035);
}

.institution-card:hover {
  border-color: #b8c8df;
  transform: translateY(-3px);
  box-shadow: 0 14px 35px rgba(16, 24, 40, 0.08);
}

.institution-card.selected {
  border: 2px solid #2563eb;
  padding: 23px;
  box-shadow: 0 15px 38px rgba(37, 99, 235, 0.1);
}

.institution-logo {
  position: relative;
  width: 58px;
  height: 58px;
  margin-bottom: 22px;
  display: grid;
  place-items: center;
  overflow: hidden;
  border: 1px solid #e5eaf1;
  border-radius: 16px;
  background: #f8fafc;
}

.institution-logo img {
  width: 80%;
  height: 80%;
  object-fit: contain;
}

.logo-fallback {
  display: none;
  color: #2563eb;
  font-size: 14px;
  font-weight: 900;
}

.logo-fallback.visible {
  display: block;
}

.institution-logo img:not([src=""]) + .logo-fallback {
  display: none;
}

.institution-code {
  color: #2563eb;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 1.5px;
}

.institution-copy h3 {
  margin: 4px 0 7px;
  color: #101828;
  font-size: 18px;
  line-height: 1.25;
}

.institution-copy p {
  margin: 0;
  color: #667085;
  font-size: 13px;
  line-height: 1.55;
  max-width: 270px;
}

.selection-check {
  position: absolute;
  right: 20px;
  bottom: 20px;
  color: #2563eb;
  font-size: 18px;
  font-weight: 900;
}

.requirements-panel {
  margin-top: 22px;
  padding: 25px;
  border: 1px solid #dce5f0;
  border-radius: 20px;
  background: #ffffff;
  box-shadow: 0 8px 25px rgba(16, 24, 40, 0.04);
}

.requirements-heading {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: flex-start;
  padding-bottom: 18px;
  border-bottom: 1px solid #edf1f5;
}

.requirements-heading h3 {
  margin: 5px 0 0;
  color: #101828;
  font-size: 20px;
}

.guide-badge {
  padding: 7px 11px;
  border-radius: 20px;
  background: #eff6ff;
  color: #2563eb;
  font-size: 11px;
  font-weight: 800;
}

.requirements-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30px;
  padding-top: 20px;
}

.requirements-columns h4 {
  margin: 0 0 12px;
  color: #344054;
  font-size: 13px;
}

.requirements-columns ul {
  list-style: none;
  margin: 0;
  padding: 0;
}

.requirements-columns li {
  display: flex;
  gap: 10px;
  margin: 10px 0;
  color: #667085;
  font-size: 13px;
  line-height: 1.55;
}

.requirements-columns li span {
  color: #16a34a;
  font-weight: 900;
}

.scholarship-guide li span {
  color: #d89b00;
}

.guide-note {
  margin-top: 18px;
  padding: 12px 14px;
  border-radius: 12px;
  background: #f8fafc;
  color: #667085;
  font-size: 12px;
  line-height: 1.55;
}

/* Form */

.form-section {
  margin-bottom: 24px;
  padding: 25px;
  border: 1px solid #e2e8f0;
  border-radius: 20px;
  background: #ffffff;
  box-shadow: 0 5px 20px rgba(16, 24, 40, 0.025);
}

.form-section-heading {
  display: flex;
  align-items: flex-start;
  gap: 13px;
  margin-bottom: 24px;
}

.form-section-heading > span {
  width: 32px;
  height: 32px;
  flex: 0 0 32px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: #eff6ff;
  color: #2563eb;
  font-size: 11px;
  font-weight: 900;
}

.form-section-heading h3 {
  margin: 1px 0 4px;
  color: #101828;
  font-size: 16px;
}

.form-section-heading p {
  margin: 0;
  color: #667085;
  font-size: 12px;
  line-height: 1.5;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.address-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.field {
  min-width: 0;
}

.field > label {
  display: block;
  margin-bottom: 8px;
  color: #344054;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.9px;
}

.field input {
  width: 100%;
  box-sizing: border-box;
  height: 48px;
  padding: 0 14px;
  border: 1px solid #d7dee8;
  border-radius: 11px;
  outline: none;
  background: #ffffff;
  color: #101828;
  font: inherit;
  font-size: 13px;
  transition: 0.18s ease;
}

.field input::placeholder {
  color: #a0a9b7;
}

.field input:focus {
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
}

.field-error {
  margin: 7px 0 0;
  color: #d92d20;
  font-size: 11px;
  font-weight: 600;
}

.gender-options,
.choice-row {
  display: flex;
  gap: 9px;
  flex-wrap: wrap;
}

.gender-options button,
.choice-row button {
  min-height: 48px;
  padding: 0 16px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1px solid #d7dee8;
  border-radius: 11px;
  background: #ffffff;
  color: #475467;
  cursor: pointer;
  font: inherit;
  font-size: 13px;
  font-weight: 700;
  transition: 0.18s ease;
}

.gender-options button:hover,
.choice-row button:hover {
  border-color: #aabbd3;
}

.gender-options button span {
  font-size: 18px;
}

.gender-options button.gender-selected,
.choice-row button.choice-selected {
  border-color: #2563eb;
  background: #eff6ff;
  color: #1d4ed8;
}

.choice-row button span {
  width: 17px;
  font-weight: 900;
}

/* Uploads */

.photo-instruction {
  display: flex;
  gap: 14px;
  margin-bottom: 20px;
  padding: 17px;
  border: 1px solid #dbe7f5;
  border-radius: 16px;
  background: #f7fbff;
}

.photo-instruction > span {
  font-size: 22px;
}

.photo-instruction strong {
  display: block;
  color: #1d2939;
  font-size: 13px;
}

.photo-instruction p {
  margin: 5px 0 0;
  color: #667085;
  font-size: 12px;
  line-height: 1.6;
}

.upload-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 17px;
}

.upload-card {
  min-width: 0;
  border: 1px dashed #c8d3e1;
  border-radius: 18px;
  background: #ffffff;
  transition: 0.2s ease;
}

.upload-card:hover,
.upload-card.has-file {
  border-color: #2563eb;
  background: #fbfdff;
}

.upload-label {
  min-height: 190px;
  padding: 22px;
  display: flex;
  flex-direction: column;
  cursor: pointer;
  box-sizing: border-box;
}

.upload-card input {
  display: none;
}

.upload-icon {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  margin-bottom: 20px;
  border-radius: 13px;
  background: #eff6ff;
  font-size: 21px;
}

.upload-copy {
  min-width: 0;
}

.upload-copy strong {
  display: block;
  color: #1d2939;
  font-size: 12px;
  line-height: 1.45;
}

.upload-copy p {
  margin: 7px 0 14px;
  color: #98a2b3;
  font-size: 11px;
  line-height: 1.5;
}

.upload-cta {
  color: #2563eb;
  font-size: 11px;
  font-weight: 800;
}

.selected-file {
  margin-top: 10px;
  padding: 10px;
  border-radius: 10px;
  background: #f0fdf4;
  overflow: hidden;
}

.selected-file span,
.selected-file small {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selected-file span {
  color: #166534;
  font-size: 11px;
  font-weight: 700;
}

.selected-file small {
  margin-top: 3px;
  color: #4b7f5a;
  font-size: 10px;
}

.upload-error {
  padding: 0 18px 15px;
}

/* Notes */

.security-note,
.help-note {
  display: flex;
  gap: 13px;
  margin-top: 20px;
  padding: 16px;
  border-radius: 14px;
  background: #f8fafc;
}

.security-note > span,
.help-note > span {
  font-size: 18px;
}

.security-note strong,
.help-note strong {
  color: #344054;
  font-size: 12px;
}

.security-note p,
.help-note p {
  margin: 4px 0 0;
  color: #667085;
  font-size: 11px;
  line-height: 1.55;
}

.help-note a {
  display: inline-block;
  margin-top: 9px;
  color: #2563eb;
  font-size: 11px;
  font-weight: 800;
  text-decoration: none;
}

.faculty-list {
  display: grid;
  gap: 14px;
  margin-top: 20px;
}

.choice-field {
  display: grid;
  grid-template-columns: 42px 1fr;
  gap: 12px;
  align-items: start;
}

.choice-number {
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: #f2f4f7;
  color: #667085;
  font-size: 11px;
  font-weight: 900;
}

/* Review */

.review-institution {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px;
  margin-bottom: 16px;
  border: 1px solid #dce5f0;
  border-radius: 16px;
  background: #ffffff;
}

.review-logo {
  width: 48px;
  height: 48px;
  flex: 0 0 48px;
  display: grid;
  place-items: center;
  overflow: hidden;
  border-radius: 12px;
  background: #f1f5f9;
  color: #2563eb;
  font-size: 11px;
  font-weight: 900;
}

.review-logo img {
  width: 80%;
  height: 80%;
  object-fit: contain;
}

.review-logo span {
  display: none;
}

.review-institution > div:nth-child(2) {
  flex: 1;
}

.review-institution > div:nth-child(2) span {
  display: block;
  color: #98a2b3;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1px;
}

.review-institution > div:nth-child(2) strong {
  display: block;
  margin-top: 3px;
  color: #101828;
  font-size: 14px;
}

.review-institution > button,
.review-section-header button {
  border: 0;
  background: transparent;
  color: #2563eb;
  cursor: pointer;
  font-size: 11px;
  font-weight: 800;
}

.review-section {
  margin-bottom: 16px;
  padding: 20px;
  border: 1px solid #e2e8f0;
  border-radius: 17px;
  background: #ffffff;
}

.review-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding-bottom: 14px;
  margin-bottom: 5px;
  border-bottom: 1px solid #edf1f5;
}

.review-section-header h3 {
  margin: 0;
  color: #101828;
  font-size: 14px;
}

.review-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.review-row {
  min-width: 0;
  padding: 11px 10px;
}

.review-row span {
  display: block;
  margin-bottom: 4px;
  color: #98a2b3;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.review-row strong {
  display: block;
  color: #344054;
  font-size: 12px;
  overflow-wrap: anywhere;
}

.review-file {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px;
}

.review-file > span {
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #ecfdf3;
  color: #16a34a;
  font-size: 11px;
  font-weight: 900;
}

.review-file strong,
.review-file small {
  display: block;
}

.review-file strong {
  color: #344054;
  font-size: 11px;
}

.review-file small {
  margin-top: 3px;
  color: #98a2b3;
  font-size: 10px;
  overflow-wrap: anywhere;
}

.consent-box {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  padding: 15px;
  border: 1px solid #dbe3ed;
  border-radius: 14px;
  background: #fbfcfe;
  cursor: pointer;
}

.consent-box input {
  margin-top: 2px;
  accent-color: #2563eb;
}

.consent-box span {
  color: #667085;
  font-size: 11px;
  line-height: 1.6;
}

/* Footer */

.application-footer {
  position: relative;
  z-index: 30;
  min-height: 76px;
  padding: 12px max(28px, 5vw);
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1px solid #e3e8ef;
  backdrop-filter: blur(14px);
}

.footer-hint {
  color: #98a2b3;
  font-size: 11px;
}

.footer-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.primary-action,
.back-action,
.secondary-action {
  min-height: 44px;
  border-radius: 11px;
  padding: 0 18px;
  font: inherit;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  transition: 0.18s ease;
}

.primary-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  border: 1px solid #2563eb;
  background: #2563eb;
  color: #ffffff;
}

.primary-action:hover {
  background: #1d4ed8;
  transform: translateY(-1px);
}

.primary-action:disabled {
  opacity: 0.65;
  cursor: wait;
  transform: none;
}

.back-action {
  border: 1px solid #d7dee8;
  background: #ffffff;
  color: #475467;
}

.back-action:hover {
  background: #f8fafc;
}

.submit-action {
  min-width: 180px;
}

/* Success */

.application-success {
  position: relative;
  width: min(680px, calc(100% - 30px));
  margin: 45px auto;
  padding: 48px 42px;
  box-sizing: border-box;
  border: 1px solid #e1e7ef;
  border-radius: 28px;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 30px 80px rgba(16, 24, 40, 0.12);
}

.success-logo-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 22px;
}

.sde-logo-placeholder {
  width: 54px;
  height: 54px;
  display: grid;
  place-items: center;
  border-radius: 15px;
  background: #111827;
  color: #ffffff;
  font-size: 13px;
  font-weight: 900;
}

.success-trophy {
  font-size: 58px;
  line-height: 1;
  margin-bottom: 15px;
}

.success-kicker {
  color: #2563eb;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 1.5px;
}

.application-success h1 {
  margin: 8px 0 10px;
  color: #101828;
  font-size: 40px;
  letter-spacing: -1.5px;
}

.success-lead {
  max-width: 510px;
  margin: 0 auto;
  color: #667085;
  font-size: 14px;
  line-height: 1.7;
}

.request-card {
  margin: 25px auto 15px;
  padding: 17px;
  border: 1px solid #dbe5f0;
  border-radius: 16px;
  background: #f8fbff;
}

.request-card span,
.request-card small {
  display: block;
}

.request-card span {
  color: #98a2b3;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.2px;
}

.request-card strong {
  display: block;
  margin: 7px 0 4px;
  color: #2563eb;
  font-size: 21px;
  letter-spacing: 0.5px;
}

.request-card small {
  color: #667085;
  font-size: 10px;
}

.success-status {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 13px 15px;
  border-radius: 13px;
  background: #f0fdf4;
  text-align: left;
}

.status-dot {
  width: 9px;
  height: 9px;
  flex: 0 0 9px;
  border-radius: 50%;
  background: #16a34a;
}

.success-status strong,
.success-status span {
  display: block;
}

.success-status strong {
  color: #166534;
