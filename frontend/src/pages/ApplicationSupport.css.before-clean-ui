  border: 0 !important;
  border-radius: 14px;

  background: #182338 !important;
  color: #ffffff !important;

  font: inherit;
  font-weight: 700;
  line-height: 1.2;

  cursor: pointer;
  visibility: visible !important;
  opacity: 1 !important;

  box-shadow: 0 10px 22px rgba(24, 35, 56, 0.18);

  transition:
    transform 0.18s ease,
    background 0.18s ease,
    box-shadow 0.18s ease;
}

.institution-next-button:hover:not(:disabled) {
  transform: translateY(-2px);
  background: #1f5baa !important;
  box-shadow: 0 14px 26px rgba(31, 91, 170, 0.22);
}

.institution-next-button:active:not(:disabled) {
  transform: translateY(0);
}

.institution-next-button:disabled {
  opacity: 0.55 !important;
  cursor: not-allowed;
}

.institution-next-button:focus-visible {
  outline: 3px solid rgba(31, 91, 170, 0.25);
  outline-offset: 3px;
}

/* ---------------------------------------------------------
   SMART CLASSES — keep compatible if new JSX is used later
   --------------------------------------------------------- */

.smart-next-card {
  position: relative !important;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: visible;
}

.smart-next-button {
  position: relative !important;
  visibility: visible !important;
  opacity: 1 !important;
  z-index: 3;
}

/* ---------------------------------------------------------
   RESPONSIVE
   --------------------------------------------------------- */

@media (max-width: 900px) {
  .institution-grid {
    grid-template-columns: 1fr;
  }

  .institution-card {
    min-height: 0;
  }

  .institution-next-card {
    align-items: stretch;
    flex-direction: column;
  }

  .institution-next-button {
    width: 100%;
    min-width: 0;
  }
}

@media (max-width: 600px) {
  .institution-grid {
    gap: 14px;
    margin-top: 18px;
  }

  .institution-card {
    padding: 20px;
    border-radius: 17px;
  }

  .institution-guidance-card {
    border-radius: 18px;
  }

  .institution-next-card {
    margin-top: 18px;
    margin-bottom: 24px;
    padding: 18px;
    border-radius: 18px;
  }

  .institution-next-button {
    width: 100%;
    min-height: 50px;
  }
}



/* ============================================================
   SDE CAREER CONNECT — APPLICATION SUPPORT
   MODERN UI SYSTEM
   Final visual layer
   ============================================================ */

:root {
  --sde-navy: #182338;
  --sde-blue: #2457d6;
  --sde-blue-dark: #1947c2;
  --sde-blue-soft: #eef4ff;
  --sde-olive: #b5b92b;

  --app-bg: #f5f7fb;
  --app-surface: #ffffff;
  --app-border: #e3e8f0;
  --app-border-strong: #d4dce8;

  --app-text: #182338;
  --app-text-soft: #5f6d82;
  --app-text-muted: #8b98aa;

  --app-success: #16845b;
  --app-danger: #c83c3c;

  --app-radius-sm: 10px;
  --app-radius-md: 14px;
  --app-radius-lg: 20px;
  --app-radius-xl: 26px;

  --app-shadow-sm: 0 4px 14px rgba(24, 35, 56, 0.05);
  --app-shadow-md: 0 12px 34px rgba(24, 35, 56, 0.08);
  --app-shadow-lg: 0 20px 50px rgba(24, 35, 56, 0.10);
}


/* ============================================================
   APPLICATION ROOT
   ============================================================ */

.application-shell {
  background: var(--app-bg);
  color: var(--app-text);
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  overflow-x: hidden !important;
}

.application-panel {
  background: var(--app-bg);
  color: var(--app-text);
}


/* ============================================================
   HEADER
   ============================================================ */

.application-header {
  position: sticky;
  top: 0;
  z-index: 50;

  min-height: 86px;
  padding: 16px clamp(22px, 5vw, 72px);

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;

  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1px solid var(--app-border);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.application-brand {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
}

.brand-mark {
  width: 48px;
  height: 48px;
  flex: 0 0 48px;

  display: grid;
  place-items: center;

  border-radius: 14px;

  background: var(--sde-navy);
  color: #ffffff;

  font-size: 0.82rem;
  font-weight: 850;
  letter-spacing: -0.04em;

  box-shadow: 0 7px 18px rgba(24, 35, 56, 0.16);
}

.application-brand strong {
  display: block;

  color: var(--sde-navy);
  font-size: 1rem;
  line-height: 1.25;
  font-weight: 800;
}

.application-brand span {
  display: block;
  margin-top: 3px;

  color: var(--app-text-muted);
  font-size: 0.78rem;
  line-height: 1.2;
}

.application-close {
  width: 48px;
  height: 48px;

  display: grid;
  place-items: center;

  border: 1px solid var(--app-border);
  border-radius: 50%;

  background: #ffffff;
  color: var(--sde-navy);

  font-size: 1.45rem;
  line-height: 1;

  cursor: pointer;

  transition:
    background 0.18s ease,
    border-color 0.18s ease,
    transform 0.18s ease;
}

.application-close:hover {
  background: #f4f7fc;
  border-color: var(--app-border-strong);
  transform: rotate(4deg);
}


/* ============================================================
   PROGRESS AREA
   ============================================================ */

.application-progress {
  width: 100%;
  box-sizing: border-box;

  padding: 20px clamp(22px, 5vw, 72px) 18px;

  background: #ffffff;
  border-bottom: 1px solid var(--app-border);
}

.progress-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;

  max-width: 1250px;
  margin: 0 auto;
}

.progress-eyebrow {
  display: block;

  color: var(--sde-blue);
  font-size: 0.7rem;
  font-weight: 850;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.progress-top h2 {
  margin: 5px 0 3px;

  color: var(--sde-navy);
  font-size: 1.25rem;
  line-height: 1.2;
  font-weight: 800;
}

.progress-top p {
  margin: 0;

  color: var(--app-text-muted);
  font-size: 0.85rem;
}

.progress-top > strong {
  color: var(--sde-blue);
  font-size: 1rem;
  font-weight: 850;
}

.progress-track {
  width: min(1250px, 100%);
  height: 6px;

  margin: 16px auto 14px;

  overflow: hidden;

  border-radius: 999px;
  background: #e8edf5;
}

.progress-track > div {
  height: 100%;

  border-radius: inherit;

  background: var(--sde-blue);

  transition: width 0.35s ease;
}

.step-indicators {
  width: min(1250px, 100%);
  margin: 0 auto;

  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12px;
}

.step-indicators > * {
  min-width: 0;
}


/* ============================================================
   MAIN CONTENT
   ============================================================ */

.application-content {
  width: min(1250px, calc(100% - 44px));
  max-width: 1250px;

  margin: 0 auto;

  padding: 48px 0 150px;

  box-sizing: border-box;
}

.form-step {
  width: 100%;
  max-width: 100%;
  min-width: 0;

  animation: sdeStepIn 0.28s ease both;
}

@keyframes sdeStepIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}


/* ============================================================
   STEP INTRO
   ============================================================ */

.intro-block {
  margin-bottom: 28px;
}

.intro-block h1 {
  color: var(--sde-navy);
  letter-spacing: -0.035em;
}

.intro-block p {
  color: var(--app-text-soft);
}


/* ============================================================
   GENERAL CARDS
   ============================================================ */

.application-content > section,
.form-step > section,
.form-step > .card,
.form-step > article {
  box-sizing: border-box;
}

.institution-guidance-card,
.institution-next-card {
  box-shadow: var(--app-shadow-md);
}


/* ============================================================
   INSTITUTION SELECTION
   ============================================================ */

.institution-grid {
  gap: 18px;
}

.institution-card {
  border: 1px solid var(--app-border) !important;
  border-radius: var(--app-radius-lg) !important;

  background: var(--app-surface) !important;
  color: var(--app-text) !important;

  box-shadow: var(--app-shadow-sm);

  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.institution-card:hover {
  transform: translateY(-4px);

  border-color: #b9c8e8 !important;

  box-shadow: var(--app-shadow-md);
}

.institution-card.selected {
  border: 2px solid var(--sde-blue) !important;

  background: #f8faff !important;

  box-shadow:
    0 12px 32px rgba(36, 87, 214, 0.12),
    inset 0 0 0 1px rgba(36, 87, 214, 0.04);
}

.institution-card.selected::after {
  content: "SELECTED";

  position: absolute;
  top: 16px;
  right: 16px;

  padding: 5px 9px;

  border-radius: 999px;

  background: var(--sde-blue-soft);
  color: var(--sde-blue);

  font-size: 0.62rem;
  font-weight: 850;
  letter-spacing: 0.07em;
}


/* ============================================================
   GUIDANCE CARD
   ============================================================ */

.institution-guidance-card {
  border: 1px solid var(--app-border) !important;
  border-radius: var(--app-radius-xl) !important;

  background: #ffffff !important;

  overflow: hidden;
}

.institution-guidance-card strong {
  color: var(--sde-navy);
}

.institution-guidance-card li::marker {
  color: var(--sde-blue);
}


/* ============================================================
   STEP 1 INLINE ACTION
   ============================================================ */

.institution-next-card {
  display: flex !important;
  align-items: center;
  justify-content: space-between;

  gap: 28px;

  padding: 22px 24px;

  border: 1px solid var(--app-border) !important;
  border-radius: var(--app-radius-lg) !important;

  background: #ffffff !important;
}

.institution-next-button,
.smart-next-button {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  gap: 12px;

  min-height: 56px;
  min-width: 250px;

  padding: 0 24px;

  border: 0 !important;
  border-radius: 14px !important;

  background: #2457d6 !important;
  color: #ffffff !important;

  font-size: 0.92rem;
  font-weight: 800;
  line-height: 1;

  box-shadow: 0 10px 24px rgba(36, 87, 214, 0.24);

  cursor: pointer;

  transition:
    transform 0.18s ease,
    background 0.18s ease,
    box-shadow 0.18s ease;
}

.institution-next-button:hover:not(:disabled),
.smart-next-button:hover:not(:disabled) {
  transform: translateY(-2px);

  background: #1947c2 !important;

  box-shadow: 0 14px 28px rgba(36, 87, 214, 0.30);
}

.institution-next-button:active:not(:disabled),
.smart-next-button:active:not(:disabled) {
  transform: translateY(0);
}

.institution-next-button:disabled,
.smart-next-button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}


/* ============================================================
   MODERN FORM FIELDS
   Applies to Steps 2–5 without changing their logic
   ============================================================ */

.form-step label {
  color: #344157;
  font-size: 0.78rem;
  font-weight: 800;
}

.form-step input,
.form-step select,
.form-step textarea {
  width: 100%;
  box-sizing: border-box;

  min-height: 50px;

  border: 1px solid var(--app-border-strong);
  border-radius: 12px;

  background: #ffffff;
  color: var(--sde-navy);

  font: inherit;
  font-size: 0.92rem;

  outline: none;

  transition:
    border-color 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease;
}

.form-step input,
.form-step select {
  padding: 0 14px;
}

.form-step textarea {
  min-height: 120px;
  padding: 14px;
  resize: vertical;
}

.form-step input:hover,
.form-step select:hover,
.form-step textarea:hover {
  border-color: #b8c5d8;
}

.form-step input:focus,
.form-step select:focus,
.form-step textarea:focus {
  border-color: var(--sde-blue);

  box-shadow:
    0 0 0 4px rgba(36, 87, 214, 0.10);

  background: #ffffff;
}

.form-step input::placeholder,
.form-step textarea::placeholder {
  color: #a0aaba;
}


/* ============================================================
   OPTION / RADIO / CHECKBOX CARDS
   ============================================================ */

.form-step button {
  font-family: inherit;
}

.form-step [role="radio"],
.form-step [role="checkbox"] {
  transition:
    border-color 0.18s ease,
    background 0.18s ease,
    transform 0.18s ease,
    box-shadow 0.18s ease;
}

.form-step [role="radio"]:hover,
.form-step [role="checkbox"]:hover {
  transform: translateY(-1px);
}


/* ============================================================
   ERRORS / VALIDATION
   ============================================================ */

.form-error,
.field-error,
.institution-selection-error {
  color: var(--app-danger);
  font-size: 0.78rem;
  font-weight: 650;
}

.form-step .error,
.form-step [aria-invalid="true"] {
  border-color: #d95353 !important;
}

.form-step [aria-invalid="true"]:focus {
  box-shadow: 0 0 0 4px rgba(200, 60, 60, 0.10);
}


/* ============================================================
   FIXED ACTION FOOTER
   Matches the supplied reference screenshot
   ============================================================ */

.application-footer {
  position: fixed !important;

  left: 0 !important;
  right: 0 !important;
  bottom: 0 !important;

  z-index: 100;

  width: 100% !important;
  min-height: 76px;

  display: flex !important;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding:
    12px
    clamp(22px, 5vw, 72px);

  box-sizing: border-box;

  background: rgba(255, 255, 255, 0.97) !important;

  border-top: 1px solid var(--app-border) !important;

  box-shadow:
    0 -10px 30px rgba(24, 35, 56, 0.06);

  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.application-footer > * {
  min-width: 0;
}

.application-footer button {
  min-height: 56px;

  border-radius: 14px !important;

  padding: 0 24px;

  font: inherit;
  font-size: 0.9rem;
  font-weight: 800;

  cursor: pointer;

  transition:
    transform 0.18s ease,
    background 0.18s ease,
    border-color 0.18s ease,
    box-shadow 0.18s ease;
}

/* Back */
.application-footer button:first-of-type {
  min-width: 100px;

  border: 1px solid #d6dfeb !important;

  background: #ffffff !important;
  color: #536177 !important;

  box-shadow: none;
}

.application-footer button:first-of-type:hover:not(:disabled) {
  border-color: #b8c5d8 !important;

  background: #f7f9fc !important;

  transform: translateY(-1px);
}

/* Continue / primary */
.application-footer button:last-of-type {
  min-width: 156px;

  border: 0 !important;

  background: #2457d6 !important;
  color: #ffffff !important;

  box-shadow:
    0 10px 24px rgba(36, 87, 214, 0.24);
}

.application-footer button:last-of-type:hover:not(:disabled) {
  background: #1947c2 !important;

  transform: translateY(-2px);

  box-shadow:
    0 14px 28px rgba(36, 87, 214, 0.30);
}

.application-footer button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}


/* ============================================================
   REVIEW / SUMMARY
   ============================================================ */

.review-card,
.summary-card,
.application-review-card {
  border: 1px solid var(--app-border) !important;
  border-radius: var(--app-radius-lg) !important;

  background: #ffffff !important;

  box-shadow: var(--app-shadow-sm);
}

.review-card:hover,
.summary-card:hover,
.application-review-card:hover {
  box-shadow: var(--app-shadow-md);
}


/* ============================================================
   SUCCESS SCREEN
   ============================================================ */

.application-success {
  box-sizing: border-box;
  padding-bottom: 120px;
}

.success-hero-icon {
  border-radius: 24px;
}

.success-tracking-pin {
  border: 1px solid #dce6f5 !important;
  border-radius: 18px !important;

  background: #f8faff !important;
}

.success-support-button {
  border-radius: 14px !important;
}


/* ============================================================
   SCROLL + OVERFLOW SAFETY
   ============================================================ */

.application-shell,
.application-panel,
.application-content,
.form-step,
.institution-grid,
.institution-guidance-card,
.institution-next-card {
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

img,
svg,
video {
  max-width: 100%;
}


/* ============================================================
   MOBILE
   ============================================================ */

@media (max-width: 768px) {

  .application-header {
    min-height: 72px;
    padding: 12px 18px;
  }

  .brand-mark {
    width: 42px;
    height: 42px;
    flex-basis: 42px;
    border-radius: 12px;
  }

  .application-close {
    width: 42px;
    height: 42px;
  }

  .application-progress {
    padding: 16px 18px;
  }

  .progress-top h2 {
    font-size: 1.05rem;
  }

  .step-indicators {
    gap: 6px;
  }

  .application-content {
    width: min(100% - 32px, 1250px);
    padding-top: 32px;
    padding-bottom: 135px;
  }

  .institution-grid {
    grid-template-columns: 1fr;
  }

  .institution-next-card {
    flex-direction: column;
    align-items: stretch;
  }

  .institution-next-button,
  .smart-next-button {
    width: 100%;
    min-width: 0;
  }

  .application-footer {
    min-height: auto;

    padding:
      10px
      16px
      calc(10px + env(safe-area-inset-bottom));

    gap: 10px;
  }

  .application-footer button {
    min-height: 52px;
    padding: 0 17px;
  }

  .application-footer button:first-of-type {
    min-width: 88px;
  }

  .application-footer button:last-of-type {
    flex: 1;
  }
}


@media (max-width: 480px) {

  .application-brand strong {
    font-size: 0.9rem;
  }

  .application-brand span {
    font-size: 0.72rem;
  }

  .application-progress {
    padding-left: 14px;
    padding-right: 14px;
  }

  .application-content {
    width: calc(100% - 24px);
    padding-top: 24px;
    padding-bottom: 130px;
  }

  .intro-block h1 {
    font-size: 1.8rem;
  }

  .intro-block p {
    font-size: 0.9rem;
  }

  .institution-card {
    border-radius: 17px !important;
  }

  .institution-next-card {
    padding: 17px;
  }

  .application-footer {
    padding-left: 12px;
    padding-right: 12px;
  }

  .application-footer button {
    font-size: 0.82rem;
  }
}


/* ============================================================
   REDUCED MOTION
   ============================================================ */

@media (prefers-reduced-motion: reduce) {

  .form-step,
  .institution-card,
  .institution-next-button,
  .smart-next-button,
  .application-footer button {
    animation: none !important;
    transition: none !important;
  }
}

