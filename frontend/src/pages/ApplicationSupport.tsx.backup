import { useEffect, useMemo, useState } from "react";
import "./ApplicationSupport.css";

type Institution = {
  id: "ur" | "rp" | "alu";
  name: string;
  shortName: string;
  description: string;
  accent: string;
};

type FormData = {
  institution: string;
  firstName: string;
  lastName: string;
  phone: string;
  email: string;
  idNumber: string;
  dateOfBirth: string;
  gender: string;
  province: string;
  district: string;
  qualification: string;
  school: string;
  completionYear: string;
  programme: string;
  supportNeeds: string[];
  applicationStatus: string;
  notes: string;
  documents: string[];
  consent: boolean;
};

const STORAGE_KEY = "sde-career-connect-application-support";

const institutions: Institution[] = [
  {
    id: "ur",
    name: "University of Rwanda",
    shortName: "UR",
    description: "Get guidance with undergraduate admission, programme choices and application preparation.",
    accent: "blue",
  },
  {
    id: "rp",
    name: "Rwanda Polytechnic",
    shortName: "RP",
    description: "Get support with RP programme selection, eligibility and application preparation.",
    accent: "green",
  },
  {
    id: "alu",
    name: "African Leadership University",
    shortName: "ALU",
    description: "Get support with ALU applications, documents, programme choices and financial aid preparation.",
    accent: "gold",
  },
];

const supportOptions = [
  "Check my eligibility",
  "Help me choose a programme",
  "Explain admission requirements",
  "Guide me through the application",
  "Prepare my documents",
  "Review my application",
  "Explain application fees",
  "Track my application",
  "General guidance",
];

const initialData: FormData = {
  institution: "",
  firstName: "",
  lastName: "",
  phone: "",
  email: "",
  idNumber: "",
  dateOfBirth: "",
  gender: "",
  province: "",
  district: "",
  qualification: "",
  school: "",
  completionYear: "",
  programme: "",
  supportNeeds: [],
  applicationStatus: "",
  notes: "",
  documents: [],
  consent: false,
};

const steps = [
  { title: "Institution", icon: "01" },
  { title: "Your details", icon: "02" },
  { title: "Education", icon: "03" },
  { title: "Support", icon: "04" },
  { title: "Review", icon: "05" },
];

function createRequestId() {
  const number = Math.floor(100000 + Math.random() * 900000);
  return `SDE-AS-${new Date().getFullYear()}-${number}`;
}

function maskId(value: string) {
  if (!value) return "Not provided";
  return value.length <= 4 ? "••••" : `••••••${value.slice(-4)}`;
}

export default function ApplicationSupport({
  onClose,
}: {
  onClose: () => void;
}) {
  const [step, setStep] = useState(0);
  const [data, setData] = useState<FormData>(() => {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      return saved ? { ...initialData, ...JSON.parse(saved) } : initialData;
    } catch {
      return initialData;
    }
  });
  const [errors, setErrors] = useState<string[]>([]);
  const [submitted, setSubmitted] = useState(false);
  const [requestId, setRequestId] = useState("");
  const [saving, setSaving] = useState(false);

  const selectedInstitution = useMemo(
    () => institutions.find((item) => item.id === data.institution),
    [data.institution],
  );

  useEffect(() => {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    } catch {
      // Ignore local storage failures.
    }
  }, [data]);

  useEffect(() => {
    document.body.classList.add("application-support-open");

    return () => {
      document.body.classList.remove("application-support-open");
    };
  }, []);

  const update = <K extends keyof FormData>(key: K, value: FormData[K]) => {
    setData((current) => ({
      ...current,
      [key]: value,
    }));
    setErrors([]);
  };

  const toggleSupport = (option: string) => {
    setData((current) => ({
      ...current,
      supportNeeds: current.supportNeeds.includes(option)
        ? current.supportNeeds.filter((item) => item !== option)
        : [...current.supportNeeds, option],
    }));
    setErrors([]);
  };

  const validateStep = () => {
    const nextErrors: string[] = [];

    if (step === 0 && !data.institution) {
      nextErrors.push("Please select the institution you need help with.");
    }

    if (step === 1) {
      if (!data.firstName.trim()) nextErrors.push("First name is required.");
      if (!data.lastName.trim()) nextErrors.push("Last name is required.");
      if (!data.phone.trim()) nextErrors.push("Phone number is required.");
      if (!data.email.trim()) nextErrors.push("Email address is required.");
      if (!data.idNumber.trim()) nextErrors.push("National ID / ID number is required.");
    }

    if (step === 2) {
      if (!data.qualification) nextErrors.push("Please select your qualification.");
      if (!data.school.trim()) nextErrors.push("Please enter your school or institution.");
      if (!data.completionYear) nextErrors.push("Please enter your completion year.");
    }

    if (step === 3) {
      if (data.supportNeeds.length === 0) {
        nextErrors.push("Please select at least one type of support.");
      }
    }

    setErrors(nextErrors);
    return nextErrors.length === 0;
  };

  const next = () => {
    if (!validateStep()) return;

    if (step < steps.length - 1) {
      setStep((current) => current + 1);
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  };

  const back = () => {
    setErrors([]);
    setStep((current) => Math.max(0, current - 1));
    window.scrollTo({ top: 0, behavior: "smooth" });
  };

  const submit = async () => {
    if (!data.consent) {
      setErrors(["Please confirm that the information you provided can be used to process your support request."]);
      return;
    }

    setSaving(true);

    const id = createRequestId();

    try {
      const form = new FormData();
      form.append("_subject", `NEW SDE APPLICATION SUPPORT REQUEST — ${id}`);
      form.append("_captcha", "false");
      form.append("_template", "table");

      form.append("Request ID", id);
      form.append("Institution", selectedInstitution?.name || data.institution);
      form.append("First name", data.firstName);
      form.append("Last name", data.lastName);
      form.append("Phone", data.phone);
      form.append("Email", data.email);
      form.append("National ID", maskId(data.idNumber));
      form.append("Date of birth", data.dateOfBirth);
      form.append("Gender", data.gender);
      form.append("District", data.district);
      form.append("Qualification", data.qualification);
      form.append("School", data.school);
      form.append("Completion year", data.completionYear);
      form.append("Programme", data.programme);
      form.append("Application status", data.applicationStatus);
      form.append("Support requested", data.supportNeeds.join(", "));
      form.append("Notes", data.notes);

      const response = await fetch(
        "https://formsubmit.co/shemaaimepacific@gmail.com",
        {
          method: "POST",
          body: form,
          headers: {
            Accept: "application/json",
          },
        },
      );

      if (!response.ok) {
        throw new Error("Email submission failed.");
      }

      localStorage.removeItem(STORAGE_KEY);
      setRequestId(id);
      setSubmitted(true);
    } catch (error) {
      console.error(error);
      setErrors([
        "We could not send your request right now. Please try again or contact us on WhatsApp.",
      ]);
    } finally {
      setSaving(false);
    }
  };

  if (submitted) {
    return (
      <div className="application-shell">
        <div className="application-success">
          <button className="application-close" onClick={onClose} aria-label="Close">
            ×
          </button>

          <div className="success-icon">✓</div>

          <span className="application-eyebrow">REQUEST RECEIVED</span>

          <h1>Your application support request is in.</h1>

          <p>
            Thank you, {data.firstName || "student"}. The SDE Career Connect team
            can now review your request and contact you using the details you provided.
          </p>

          <div className="request-card">
            <span>Request ID</span>
            <strong>{requestId}</strong>
            <small>Keep this ID so you can refer to your request later.</small>
          </div>

          <div className="success-actions">
            <a
              href="https://wa.me/250796371484"
              target="_blank"
              rel="noreferrer"
              className="application-primary-button"
            >
              Chat on WhatsApp ↗
            </a>

            <button className="application-secondary-button" onClick={onClose}>
              Return to SDE Career Connect
            </button>
          </div>

          <div className="status-line">
            <span className="status-dot" />
            Status: <strong>Received</strong>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="application-shell">
      <header className="application-header">
        <div className="application-brand">
          <div className="application-brand-mark">SDE</div>
          <div>
            <strong>Career Connect</strong>
            <span>Application Support</span>
          </div>
        </div>

        <button className="application-close" onClick={onClose} aria-label="Close application support">
          ×
        </button>
      </header>

      <main className="application-main">
        <section className="application-intro">
          <div>
            <span className="application-eyebrow">APPLICATION SUPPORT</span>
            <h1>Let's get your application right.</h1>
            <p>
              Tell us what you need help with. We'll guide you through the
              important steps without making the process confusing.
            </p>
          </div>

          <div className="application-contact">
            <span>Need help now?</span>
            <a href="https://wa.me/250796371484" target="_blank" rel="noreferrer">
              WhatsApp SDE ↗
            </a>
          </div>
        </section>

        <div className="application-progress">
          {steps.map((item, index) => (
            <div
              className={`progress-step ${index === step ? "active" : ""} ${
                index < step ? "complete" : ""
              }`}
              key={item.title}
            >
              <div className="progress-number">
                {index < step ? "✓" : item.icon}
              </div>
              <span>{item.title}</span>
            </div>
          ))}
        </div>

        <form
          className="application-card"
          onSubmit={(event) => {
            event.preventDefault();
            if (step === steps.length - 1) {
              void submit();
            } else {
              next();
            }
          }}
        >
          {errors.length > 0 && (
            <div className="application-errors" role="alert">
              <strong>Please check the following:</strong>
              <ul>
                {errors.map((error) => (
                  <li key={error}>{error}</li>
                ))}
              </ul>
            </div>
          )}

          {step === 0 && (
            <div className="application-step">
              <div className="step-heading">
                <span>01</span>
                <div>
                  <h2>Where are you applying?</h2>
                  <p>Choose the institution you want SDE to help you with.</p>
                </div>
              </div>

              <div className="institution-grid">
                {institutions.map((institution) => (
                  <button
                    type="button"
                    key={institution.id}
                    className={`institution-card ${
                      data.institution === institution.id ? "selected" : ""
                    } ${institution.accent}`}
                    onClick={() => update("institution", institution.id)}
                  >
                    <div className="institution-top">
                      <span className="institution-badge">{institution.shortName}</span>
                      {data.institution === institution.id && (
                        <span className="institution-check">✓</span>
                      )}
                    </div>

                    <h3>{institution.name}</h3>
                    <p>{institution.description}</p>

                    <span className="institution-action">
                      {data.institution === institution.id ? "Selected" : "Select institution"}
                    </span>
                  </button>
                ))}
              </div>

              {selectedInstitution && (
                <div className="admission-guide">
                  <div className="guide-header">
                    <span>✓</span>
                    <div>
                      <strong>
                        {selectedInstitution.shortName === "UR"
                          ? "UR admission checklist"
                          : selectedInstitution.shortName === "RP"
                            ? "RP admission checklist"
                            : "ALU admission & scholarship checklist"}
                      </strong>
                      <small>Use this as a preparation guide before applying.</small>
                    </div>
                  </div>

                  <div className="guide-columns">
                    <div>
                      <h4>Admission</h4>
                      <ul>
                        {selectedInstitution.shortName === "UR" && (
                          <>
                            <li>Advanced Level certificate or equivalent qualification</li>
                            <li>At least two relevant principal passes</li>
                            <li>Meet the specific subject combination for your programme</li>
                            <li>National ID / passport where applicable</li>
                            <li>S6 index number and academic information</li>
                            <li>Required programme-specific documents</li>
                            <li>Application fee and payment information</li>
                          </>
                        )}

                        {selectedInstitution.shortName === "RP" && (
                          <>
                            <li>S6 certificate or Level 5 TVET completion certificate</li>
                            <li>At least two relevant principal passes</li>
                            <li>Relevant subjects/modules for the selected programme</li>
                            <li>National ID or valid passport</li>
                            <li>Valid email and application information</li>
                            <li>Certified academic documents during registration</li>
                            <li>Advanced Diploma holders may use transcripts/certificates for BTech</li>
                          </>
                        )}

                        {selectedInstitution.shortName === "ALU" && (
                          <>
                            <li>Secondary-school qualification and academic records</li>
                            <li>Programme-specific academic requirements</li>
                            <li>Personal and high-school information</li>
                            <li>Required supporting documents</li>
                            <li>Programme and intake selection</li>
                            <li>Financial information during the finance stage</li>
                          </>
                        )}
                      </ul>
                    </div>

                    {selectedInstitution.shortName === "ALU" ? (
                      <div>
                        <h4>Scholarship / Financial Aid</h4>
                        <ul>
                          <li>Complete the ALU admission process</li>
                          <li>Show financial need where required</li>
                          <li>Prepare supporting financial information/documents</li>
                          <li>Provide academic information</li>
                          <li>Highlight leadership, initiative and community involvement</li>
                          <li>Check the specific scholarship eligibility criteria</li>
                        </ul>
                      </div>
                    ) : (
                      <div>
                        <h4>SDE can help you</h4>
                        <ul>
                          <li>Check your qualification</li>
                          <li>Check your subject combination</li>
                          <li>Compare your programme options</li>
                          <li>Prepare your documents</li>
                          <li>Guide you through the application</li>
                          <li>Review your application before submission</li>
                        </ul>
                      </div>
                    )}
                  </div>
                </div>
              )}

              {selectedInstitution && (
                <div className="selected-note">
                  <span>✓</span>
                  You're requesting support for <strong>{selectedInstitution.name}</strong>.
                </div>
              )}
            </div>
          )}

          {step === 1 && (
            <div className="application-step">
              <div className="step-heading">
                <span>02</span>
                <div>
                  <h2>Tell us about you</h2>
                  <p>We'll use these details to contact you about your request.</p>
                </div>
              </div>

              <div className="form-grid">
                <label>
                  <span>First name <b>*</b></span>
                  <input
                    value={data.firstName}
                    onChange={(e) => update("firstName", e.target.value)}
                    placeholder="e.g. Aime"
                    autoComplete="given-name"
                  />
                </label>

                <label>
                  <span>Last name <b>*</b></span>
                  <input
                    value={data.lastName}
                    onChange={(e) => update("lastName", e.target.value)}
                    placeholder="e.g. Shema"
                    autoComplete="family-name"
                  />
                </label>

                <label>
                  <span>Phone number <b>*</b></span>
                  <input
                    type="tel"
                    value={data.phone}
                    onChange={(e) => update("phone", e.target.value)}
                    placeholder="+250 7XX XXX XXX"
                    autoComplete="tel"
                  />
                </label>

                <label>
                  <span>Email address <b>*</b></span>
                  <input
                    type="email"
                    value={data.email}
                    onChange={(e) => update("email", e.target.value)}
                    placeholder="you@example.com"
                    autoComplete="email"
                  />
                </label>

                <label>
                  <span>National ID / ID number <b>*</b></span>
                  <input
                    value={data.idNumber}
                    onChange={(e) => update("idNumber", e.target.value)}
                    placeholder="Enter your ID number"
                    autoComplete="off"
                  />
                  <small>Used only to help identify your application request.</small>
                </label>

                <label>
                  <span>Date of birth</span>
                  <input
                    type="date"
                    value={data.dateOfBirth}
                    onChange={(e) => update("dateOfBirth", e.target.value)}
                  />
                </label>

                <label>
                  <span>Gender</span>
                  <select
                    value={data.gender}
                    onChange={(e) => update("gender", e.target.value)}
                  >
                    <option value="">Select</option>
                    <option>Male</option>
                    <option>Female</option>
                    <option>Prefer not to say</option>
                  </select>
                </label>

                <label>
                  <span>District</span>
                  <input
                    value={data.district}
                    onChange={(e) => update("district", e.target.value)}
                    placeholder="e.g. Gasabo"
                  />
                </label>
              </div>
            </div>
          )}

          {step === 2 && (
            <div className="application-step">
              <div className="step-heading">
                <span>03</span>
                <div>
                  <h2>Your education</h2>
                  <p>Help us understand your academic background.</p>
                </div>
              </div>

              <div className="form-grid">
                <label>
                  <span>Highest qualification <b>*</b></span>
                  <select
                    value={data.qualification}
                    onChange={(e) => update("qualification", e.target.value)}
                  >
                    <option value="">Select qualification</option>
                    <option>S6 / Advanced Level</option>
                    <option>Level 5 TVET</option>
                    <option>Advanced Diploma</option>
                    <option>Diploma</option>
                    <option>Bachelor's Degree</option>
                    <option>Other</option>
                  </select>
                </label>

                <label>
                  <span>Completion year <b>*</b></span>
                  <input
                    type="number"
                    min="2000"
                    max="2035"
                    value={data.completionYear}
                    onChange={(e) => update("completionYear", e.target.value)}
                    placeholder="e.g. 2026"
                  />
                </label>

                <label className="full-width">
                  <span>School / institution <b>*</b></span>
                  <input
                    value={data.school}
                    onChange={(e) => update("school", e.target.value)}
                    placeholder="Name of your secondary school or institution"
                  />
                </label>

                <label>
                  <span>Programme you want to study</span>
                  <input
                    value={data.programme}
                    onChange={(e) => update("programme", e.target.value)}
                    placeholder="e.g. Computer Science"
                  />
                </label>

                <label>
                  <span>Application status</span>
                  <select
                    value={data.applicationStatus}
                    onChange={(e) => update("applicationStatus", e.target.value)}
                  >
                    <option value="">Select status</option>
                    <option>I have not started</option>
                    <option>I have started</option>
                    <option>I submitted my application</option>
                    <option>I received an admission decision</option>
                    <option>I am not sure</option>
                  </select>
                </label>
              </div>
            </div>
          )}

          {step === 3 && (
            <div className="application-step">
              <div className="step-heading">
                <span>04</span>
                <div>
                  <h2>What do you need help with?</h2>
                  <p>Select everything that applies to your situation.</p>
                </div>
              </div>

              {selectedInstitution?.shortName === "ALU" && (
                <div className="alu-support-type">
                  <span>ALU support type</span>
                  <div>
                    {["Admission", "Scholarship / Financial Aid", "Both"].map((item) => (
                      <button
                        type="button"
                        key={item}
                        className="alu-type"
                        onClick={() => {
                          if (item === "Admission") {
                            update("supportNeeds", [
                              "Guide me through the application",
                              "Check my eligibility",
                            ]);
                          } else if (item === "Scholarship / Financial Aid") {
                            update("supportNeeds", [
                              "General guidance",
                              "Prepare my documents",
                            ]);
                          } else {
                            update("supportNeeds", [
                              "Guide me through the application",
                              "General guidance",
                              "Prepare my documents",
                            ]);
                          }
                        }}
                      >
                        {item}
                      </button>
                    ))}
                  </div>
                </div>
              )}

              <div className="support-options">
                {supportOptions.map((option) => (
                  <button
                    type="button"
                    key={option}
                    className={`support-option ${
                      data.supportNeeds.includes(option) ? "selected" : ""
                    }`}
                    onClick={() => toggleSupport(option)}
                  >
                    <span>{data.supportNeeds.includes(option) ? "✓" : "+"}</span>
                    {option}
                  </button>
                ))}
              </div>

              <label className="textarea-label">
                <span>Anything else we should know?</span>
                <textarea
                  value={data.notes}
                  onChange={(e) => update("notes", e.target.value)}
                  placeholder="Tell us about your situation, challenge or question..."
                  rows={5}
                />
              </label>
            </div>
          )}

          {step === 4 && (
            <div className="application-step">
              <div className="step-heading">
                <span>05</span>
                <div>
                  <h2>Review your request</h2>
                  <p>Check your information before sending it to SDE Career Connect.</p>
                </div>
              </div>

              <div className="review-grid">
                <div className="review-section">
                  <div className="review-title">
                    <span>Institution</span>
                    <button type="button" onClick={() => setStep(0)}>Edit</button>
                  </div>
                  <strong>{selectedInstitution?.name || "Not selected"}</strong>
                </div>

                <div className="review-section">
                  <div className="review-title">
                    <span>Student</span>
                    <button type="button" onClick={() => setStep(1)}>Edit</button>
                  </div>
                  <strong>{data.firstName} {data.lastName}</strong>
                  <small>{data.email} · {data.phone}</small>
                  <small>ID: {maskId(data.idNumber)}</small>
                </div>

                <div className="review-section">
                  <div className="review-title">
                    <span>Education</span>
                    <button type="button" onClick={() => setStep(2)}>Edit</button>
                  </div>
                  <strong>{data.qualification}</strong>
                  <small>{data.school} · {data.completionYear}</small>
                  {data.programme && <small>Programme: {data.programme}</small>}
                </div>

                <div className="review-section">
                  <div className="review-title">
                    <span>Support requested</span>
                    <button type="button" onClick={() => setStep(3)}>Edit</button>
                  </div>
                  <div className="review-tags">
                    {data.supportNeeds.map((item) => (
                      <span key={item}>{item}</span>
                    ))}
                  </div>
                </div>
              </div>

              <label className="consent-box">
                <input
                  type="checkbox"
                  checked={data.consent}
                  onChange={(e) => update("consent", e.target.checked)}
                />
                <span>
                  I confirm that the information I provided is accurate and I
                  allow SDE Career Connect to use it to respond to my support request.
                </span>
              </label>
            </div>
          )}

          <div className="application-footer">
            <div className="footer-help">
              <span>Need direct assistance?</span>
              <a href="https://wa.me/250796371484" target="_blank" rel="noreferrer">
                WhatsApp +250 796 371 484
              </a>
            </div>

            <div className="footer-actions">
              {step > 0 && (
                <button type="button" className="application-back" onClick={back}>
                  ← Back
                </button>
              )}

              {step < steps.length - 1 ? (
                <button type="submit" className="application-primary-button">
                  Continue →
                </button>
              ) : (
                <button
                  type="submit"
                  className="application-primary-button"
                  disabled={saving}
                >
                  {saving ? "Sending request..." : "Submit support request"}
                </button>
              )}
            </div>
          </div>
        </form>

        <p className="application-security">
          🔒 Your ID information is protected and will not be displayed publicly.
        </p>
      </main>
    </div>
  );
}
